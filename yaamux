_brief_markdown() {
  local version="${YAAMUX_VERSION:-}"
  if [[ -z "$version" ]]; then
    local c
    for c in "${YAAMUX_HOME}/VERSION" "${YAAMUX_HOME}/../share/yaamux/VERSION"; do
      [[ -f "$c" ]] && { version="$(cat "$c")"; break; }
    done
    version="${version:-dev}"
  fi
  printf '# yaamux agent brief (v%s)\n\n' "$version"
  _brief_situational_markdown
  printf '\n## Commands you can use\n'
  local group flag summary prev_group=""
  local heading
  while IFS=$'\t' read -r group flag summary; do
    [[ -z "$group" ]] && continue
    case "$group" in
      read|coordinate|background|ship) ;;
      *) continue ;;
    esac
    if [[ "$group" != "$prev_group" ]]; then
      case "$group" in
        read)       heading="Read / inspect" ;;
        coordinate) heading="Coordinate with siblings" ;;
        background) heading="Background work (non-blocking)" ;;
        ship)       heading="Ship" ;;
      esac
      printf '\n### %s\n' "$heading"
      prev_group="$group"
    fi
    printf -- '- `yaamux %s` — %s\n' "$flag" "$summary"
  done < <(_brief_data)
  printf '\n## Do not run these (refused while YAAMUX_AGENT_MODE=safe)\n\n'
  while IFS=$'\t' read -r group flag summary; do
    [[ "$group" == "refused" ]] || continue
    printf -- '- `yaamux %s` — %s\n' "$flag" "$summary"
  done < <(_brief_data)
  printf '\nFull reference: `yaamux --keys`.\n'
}

