_init_repo() {
  # Parse opt-in flags. `--with-docs` copies YAAMUX.md into the repo;
  # `--copy-skill` vendors the Claude Code skill instead of symlinking it.
  local with_docs="" copy_skill=0 arg
  for arg in "$@"; do
    case "$arg" in
      --with-docs)  with_docs="--with-docs" ;;
      --copy-skill) copy_skill=1 ;;
      "" ) ;;
      *) warn "Unknown --init flag: $arg (try: --with-docs, --copy-skill)" ;;
    esac
  done

  # AGENTS.md (canonical per agents.md — read by 60+ tools)
  if [[ -f "${REPO_ROOT}/AGENTS.md" ]]; then
    log "AGENTS.md already exists — keeping."
  elif [[ -f "${REPO_ROOT}/CLAUDE.md" && ! -L "${REPO_ROOT}/CLAUDE.md" ]]; then
    mv "${REPO_ROOT}/CLAUDE.md" "${REPO_ROOT}/AGENTS.md"
    log "Renamed CLAUDE.md → AGENTS.md (canonical per agents.md spec)."
  else
    _write_agents_md_stub
    log "Wrote AGENTS.md starter template."
  fi

  # CLAUDE.md → symlink to AGENTS.md (for Claude Code discovery)
  if [[ -L "${REPO_ROOT}/CLAUDE.md" ]]; then
    log "CLAUDE.md is already a symlink — keeping."
  elif [[ -f "${REPO_ROOT}/CLAUDE.md" ]]; then
    warn "CLAUDE.md exists as a separate file alongside AGENTS.md — leaving alone."
  else
    ln -s AGENTS.md "${REPO_ROOT}/CLAUDE.md"
    log "Symlinked CLAUDE.md → AGENTS.md."
  fi

  # .yaamux/config (per-project defaults)
  if [[ -f "${REPO_ROOT}/.yaamux/config" ]]; then
    log ".yaamux/config already exists — keeping."
  else
    _write_yaamux_config
    log "Wrote .yaamux/config (project defaults)."
  fi

  # .worktreeinclude (env+secret copy list)
  if [[ -f "${REPO_ROOT}/.worktreeinclude" ]]; then
    log ".worktreeinclude already exists — keeping."
  else
    _write_worktreeinclude_stub
    log "Wrote .worktreeinclude (.env* copied into worktrees by default)."
  fi

  # .yaamux/state (per-repo, mutable — control panel visibility & mode).
  # Committable or gitignored at the user's choice; we gitignore by default.
  if [[ ! -f "${REPO_ROOT}/.yaamux/state" ]]; then
    mkdir -p "${REPO_ROOT}/.yaamux"
    cat > "${REPO_ROOT}/.yaamux/state" << 'STATE_EOF'
# yaamux per-repo state — mutable, written by --toggle-panel.
# Override with ~/.config/yaamux/control-panel.conf (global) — per-repo wins.
CONTROL_PANEL_VISIBLE=true
CONTROL_PANEL_MODE=auto    # auto | tile | sidebar
STATE_EOF
    log "Wrote .yaamux/state (control-panel defaults)."
  fi

  # .claude/skills/yaamux/  — Claude Code skill (issue #29 Tier 2). Symlink by
  # default so `yaamux --update` propagates skill changes; opt out with
  # `--copy-skill` to vendor a snapshot independent of YAAMUX_HOME.
  local skill_src skill_dst="${REPO_ROOT}/.claude/skills/yaamux"
  local skill_was_symlinked=0
  if skill_src="$(_skill_src)"; then
    mkdir -p "${REPO_ROOT}/.claude/skills"
    if [[ -e "$skill_dst" || -L "$skill_dst" ]]; then
      log ".claude/skills/yaamux already exists — keeping."
      [[ -L "$skill_dst" ]] && skill_was_symlinked=1
    elif [[ "$copy_skill" -eq 1 ]]; then
      cp -R "$skill_src" "$skill_dst"
      log "Copied skill into .claude/skills/yaamux/ (vendored snapshot)."
    else
      ln -s "$skill_src" "$skill_dst"
      log "Linked .claude/skills/yaamux → ${skill_src}."
      skill_was_symlinked=1
    fi
  else
    warn "Skill source dir not found (looked under ${YAAMUX_HOME}/skills and ../share/yaamux/skills) — skipping skill install."
  fi

  # .gitignore additions (only if .gitignore is present). The skill entry
  # is added only when we're symlinking — a vendored copy is meant to be
  # tracked by the user, not ignored.
  if [[ -f "${REPO_ROOT}/.gitignore" ]]; then
    local entries=(".claude/logs/" "../${PROJECT_NAME}-worktrees/" ".yaamux/state" ".yaamux/panels/" ".yaamux/lazygit/")
    [[ "$skill_was_symlinked" -eq 1 ]] && entries+=(".claude/skills/yaamux")
    local added=0 entry
    for entry in "${entries[@]}"; do
      if ! grep -qxF "$entry" "${REPO_ROOT}/.gitignore"; then
        echo "$entry" >> "${REPO_ROOT}/.gitignore"
        added=$((added+1))
      fi
    done
    [[ $added -gt 0 ]] && log "Added $added entries to .gitignore."
  fi

  # Optional: copy YAAMUX.md if --with-docs
  [[ "$with_docs" == "--with-docs" ]] && _add_docs

  echo ""
  log "${BOLD}yaamux initialized for ${PROJECT_NAME}.${NC}"
  echo "  Try:    yaamux 2           (boots 2 agents)"
  echo "  Manage: yaamux --list / --status / --kill / --clean"
  echo "  Docs:   yaamux --add-docs  (copies YAAMUX.md into the repo)"
}

# =============================================================================
#  Remote ops — `--remote <host>` operates on yaamux sessions over SSH
# =============================================================================
# PATH prelude pasted into every remote script so tmux is discoverable when
# ssh runs non-interactively (it doesn't source .zshrc / .bashrc). Prepends
# common install dirs so Homebrew/MacPorts/user-local wins over any older
# system binary. Single-quoted so $HOME/$PATH stay literal locally and are
# expanded by the remote shell.
REMOTE_PATH_PRELUDE='export PATH="/opt/homebrew/bin:/usr/local/bin:/opt/local/bin:$HOME/.local/bin:$HOME/bin:$PATH"'

# Value for `mosh --server=`.  mosh-server is launched by the mosh client over
# ssh *before* any user shell rc runs, so on a stock macOS desktop ssh's non-
# interactive PATH (just /usr/bin:/bin) doesn't see Homebrew/MacPorts and mosh
# bails with "NoMoshServerArgs - Did not find mosh server startup message".
# Prefixing the same PATH prelude used elsewhere makes mosh-server discoverable
# without the user having to touch ~/.zshenv.  No-op on Linux where mosh-server
# already lives in /usr/bin.  Note: do NOT append 'new' — mosh client appends
# 'new -s -c …' to whatever --server= specifies, so the value ends at the bare
# mosh-server invocation.
MOSH_SERVER_CMD="${REMOTE_PATH_PRELUDE}; exec mosh-server"

# Is mosh-server on the PATH that ssh (non-interactive) and mosh-client see by
# default? Used by the startup self-check and `--prepare-host`. /usr/local/bin
# and /usr/bin are both on macOS `path_helper`'s defaults (and on every Linux
# distro). /opt/homebrew/bin (Apple Silicon Homebrew) is NOT — so a fresh M-
# series Mac with `brew install mosh` has mosh-server invisible to a bare
# `mosh user@host` (the form iOS clients use when opening a `mosh://` URL).
# YAAMUX_PREPARE_HOST_TARGET overrides the check for `--prepare-host`'s
# bats tests (test-only knob — see _prepare_host_mosh).
_mosh_server_on_default_path() {
  local override="${YAAMUX_PREPARE_HOST_TARGET:-}"
  if [[ -n "$override" ]]; then
    [[ -x "$override" ]]
    return $?
  fi
  [[ -x /usr/local/bin/mosh-server ]] || [[ -x /usr/bin/mosh-server ]]
}

# Common ssh options reused by every remote call.  ConnectTimeout caps the
# wait on unreachable hosts.  ControlMaster shares one auth across the list,
# pick and attach calls in a single `yaamux --remote` invocation — so a
# password (if used) is typed once instead of per ssh call.
#
# ControlPath socket dir is under $HOME (created on first use by
# _remote_dispatch). That dodges the macOS Unix-socket 104-byte cap that
# bites when $TMPDIR is `/var/folders/<2>/<28>/T/` (~50 chars) and
# OpenSSH's 40-char %C hash gets appended. Per-user isolation comes from
# $HOME being user-owned — %C itself hashes %l%h%p%r (local host, target
# host, port, remote user; not the local user), so multi-tenant /tmp would
# need %u additionally — we sidestep that whole question by living in
# $HOME/.cache.
#
# ControlPersist=10m so the master survives the picker prompt and any
# back-and-forth — short enough that stale sockets get cleaned up promptly.
_REMOTE_SSH_SOCK_DIR="${HOME}/.cache/yaamux/sockets"
_REMOTE_SSH_OPTS=(
  -o ConnectTimeout=10
  -o ControlMaster=auto
  -o "ControlPath=${_REMOTE_SSH_SOCK_DIR}/%C"
  -o ControlPersist=10m
)

# Resolve an alias from ${HOSTS_CONF} to a real ssh target.
# Format:  <alias>  <ssh-target>   (whitespace-separated; '#' comments allowed)
# If no match, the input is returned untouched (assumed to be a ssh target).
_remote_resolve_host() {
  local name="$1"
  [[ -z "$name" ]] && { echo ""; return; }
  if [[ -f "$HOSTS_CONF" ]]; then
    local line a t
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%#*}"
      [[ -z "${line// /}" ]] && continue
      read -r a t <<< "$line"
      if [[ "$a" == "$name" ]]; then echo "$t"; return; fi
    done < "$HOSTS_CONF"
  fi
  echo "$name"
}

# Stream remote yaamux-* sessions as pipe-separated lines:
#   <session>|<attached-count>|<agents-count>|<repo-path>
# Uses raw tmux on the remote — no dependency on yaamux being on the remote PATH.
# Exits non-zero (127) if tmux is missing on the remote, so callers can
# distinguish "no sessions" from "tmux unavailable".
_remote_list_raw() {
  local target="$1"
  ssh "${_REMOTE_SSH_OPTS[@]}" -- "$target" "${REMOTE_PATH_PRELUDE}"'
command -v tmux >/dev/null 2>&1 || { echo "tmux not found on remote" >&2; exit 127; }
tmux list-sessions -F "#{session_name}|#{session_attached}" 2>/dev/null | while IFS="|" read -r n a; do
  case "$n" in yaamux-*) ;; *) continue;; esac
  ag=$(tmux list-panes -t "${n}:agents" 2>/dev/null | wc -l | tr -d " ")
  rp=$(tmux show-option -v -t "$n" @yaamux-repo 2>/dev/null || echo "?")
  echo "${n}|${a}|${ag:-0}|${rp}"
done
'
}

# Print remote session table (or JSON if format=json).
_remote_print_list() {
  local target="$1" format="${2:-human}"
  local raw att rc=0
  raw="$(_remote_list_raw "$target")" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    [[ "$format" == "json" ]] && echo "[]"
    die "SSH to ${target} failed (exit ${rc})."
  fi
  if [[ -z "$raw" ]]; then
    [[ "$format" == "json" ]] && echo "[]" || log "No yaamux sessions on ${target}."
    return
  fi
  if [[ "$format" == "json" ]]; then
    printf '%s\n' "$raw" | python3 -c '
import json, sys
items=[]
for line in sys.stdin.read().splitlines():
  if not line: continue
  p=line.split("|")
  if len(p)<4: continue
  items.append({"session":p[0],"attached":p[1] not in ("0",""),"agents":int(p[2] or 0),"repo":p[3]})
print(json.dumps(items, indent=2))
'
    return
  fi
  printf "%-30s %-8s %-10s %s\n" "SESSION" "AGENTS" "ATTACHED" "REPO"
  local n a ag rp
  while IFS='|' read -r n a ag rp; do
    [[ -z "$n" ]] && continue
    att="no"; [[ "$a" =~ ^[0-9]+$ && "$a" -gt 0 ]] && att="yes"
    printf "%-30s %-8s %-10s %s\n" "$n" "$ag" "$att" "$rp"
  done <<< "$raw"
}

# Interactive picker.  Writes table+prompt to stderr; chosen session to stdout.
# Returns 1 if no sessions or user cancels;  2 if SSH itself failed.
_remote_pick_session() {
  local target="$1"
  local raw rc=0
  raw="$(_remote_list_raw "$target")" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    warn "SSH to ${target} failed (exit ${rc})." >&2
    return 2
  fi
  if [[ -z "$raw" ]]; then
    log "No yaamux sessions on ${target}." >&2
    return 1
  fi
  local lines=()
  while IFS= read -r line; do [[ -n "$line" ]] && lines+=("$line"); done <<< "$raw"
  local count="${#lines[@]}"
  if [[ "$count" -eq 1 ]]; then
    local only="${lines[0]%%|*}"
    log "Single session on ${target} — attaching to ${only}." >&2
    echo "$only"
    return 0
  fi
  echo "" >&2
  echo "yaamux sessions on ${target}:" >&2
  printf "  %-5s %-30s %-8s %-10s %s\n" "#" "SESSION" "AGENTS" "ATTACHED" "REPO" >&2
  local i=1 n a ag rp att
  for line in "${lines[@]}"; do
    IFS='|' read -r n a ag rp <<< "$line"
    att="no"; [[ "$a" =~ ^[0-9]+$ && "$a" -gt 0 ]] && att="yes"
    printf "  [%-3s] %-30s %-8s %-10s %s\n" "$i" "$n" "$ag" "$att" "$rp" >&2
    i=$((i+1))
  done
  echo "" >&2
  local pick
  read -rp "Pick session [1-${count}, q to quit]: " pick
  [[ -z "$pick" || "$pick" == "q" || "$pick" == "Q" ]] && return 1
  if ! [[ "$pick" =~ ^[0-9]+$ ]] || [[ "$pick" -lt 1 ]] || [[ "$pick" -gt "$count" ]]; then
    warn "Invalid choice." >&2
    return 1
  fi
  echo "${lines[$((pick-1))]%%|*}"
}

# Bare repo name → yaamux-<repo>;  pass-through if already prefixed.
_remote_normalize_session() {
  local s="$1"
  [[ "$s" == yaamux-* ]] && echo "$s" || echo "yaamux-${s}"
}

# Attach to a remote session.  Optional zoom_idx (0-based) zooms one pane on attach.
# Honors YAAMUX_USE_MOSH=1 to use mosh instead of ssh -t.
#
# Override TERM to a universally-known value (xterm-256color by default) before
# tmux runs, so terminals whose terminfo isn't on the remote (e.g. ghostty,
# kitty, wezterm) don't fail with "missing or unsuitable terminal: …".
# Set YAAMUX_REMOTE_TERM to override (e.g. if you've installed the terminal's
# terminfo on the remote and want full feature parity).
_remote_attach() {
  local target="$1" session="$2" zoom_idx="${3:-}"
  case "$session" in *\'*|*\"*|*\\*|*\;*) die "Invalid session name: ${session}" ;; esac
  local term="${YAAMUX_REMOTE_TERM:-xterm-256color}"
  case "$term" in [A-Za-z0-9._-]*) ;; *) die "YAAMUX_REMOTE_TERM has unsafe chars: ${term}" ;; esac

  # Pre-attach triage — run client-side before exec'ing transport so any
  # prompt the user sees isn't overwritten by remote tmux paints.
  _remote_triage_prompt "$target" "$session" || { log "Quit before attach."; return 0; }

  local remote_cmd="${REMOTE_PATH_PRELUDE}; TERM=${term} tmux attach -t '${session}'"
  if [[ -n "$zoom_idx" ]]; then
    remote_cmd="${REMOTE_PATH_PRELUDE}; TERM=${term} tmux select-window -t '${session}:agents' \\; \
select-pane -t '${session}:agents.${zoom_idx}' \\; \
resize-pane -t '${session}:agents.${zoom_idx}' -Z \\; \
attach -t '${session}'"
  fi
  if [[ "${YAAMUX_USE_MOSH:-0}" == "1" ]]; then
    command -v mosh &>/dev/null || die "mosh not installed locally — brew install mosh, or drop --mosh."
    log "mosh ${target} → ${session}"
    # sh -lc (not bash) keeps the remote dep at POSIX sh + mosh-server.
    # --server= bakes a PATH prelude so mosh-server is found on macOS-Homebrew
    # remotes (see MOSH_SERVER_CMD).
    exec mosh --server="$MOSH_SERVER_CMD" "$target" -- sh -lc "$remote_cmd"
  fi
  log "ssh -t ${target} → ${session}"
  exec ssh "${_REMOTE_SSH_OPTS[@]}" -t -- "$target" "$remote_cmd"
}

# Remote-side triage. Same UX as the local one, but the state-classification
# runs via ssh awk on the remote (no _pane_state on the remote side).
# Returns:
#   0  proceed with attach (no issues, or user picked attach)
#   1  user picked quit
# If user picks "heal-all", we issue restart commands over ssh per pane
# (`tmux send-keys`), then proceed to attach.
_remote_triage_prompt() {
  local target="$1" session="$2"
  [[ "${YAAMUX_NO_TRIAGE:-0}" == "1" ]] && return 0
  [[ -t 0 ]] || return 0
  local raw
  raw="$(ssh "${_REMOTE_SSH_OPTS[@]}" -- "$target" "${REMOTE_PATH_PRELUDE}
shells=\"\$(tmux show-option -v -t '${session}' @yaamux-shells 2>/dev/null || echo 'zsh bash sh fish dash ash')\"
tmux list-panes -t '${session}:agents' -F '#{pane_index}|#{pane_title}|#{pane_dead}|#{pane_current_command}' 2>/dev/null \\
  | awk -F'|' -v sh=\"\$shells\" '
    BEGIN { n = split(sh, s, /[ \\t]+/); for (i=1;i<=n;i++) is_shell[s[i]] = 1 }
    {
      st = (\$3 == 1) ? \"dead\" : (is_shell[\$4] ? \"idle\" : \"running\")
      if (st != \"running\") printf \"%s|%s|%s\\n\", \$1, st, \$2
    }'
" 2>/dev/null)" || return 0
  [[ -z "$raw" ]] && return 0
  local issues=()
  while IFS= read -r line; do [[ -n "$line" ]] && issues+=("$line"); done <<< "$raw"
  echo "" >&2
  warn "${#issues[@]} agent pane(s) on ${session} need attention:" >&2
  local idx state title rec
  for rec in "${issues[@]}"; do
    IFS='|' read -r idx state title <<< "$rec"
    printf "  pane #%s  %-8s %s\n" "$idx" "[$state]" "$title" >&2
  done
  echo "" >&2
  echo -n "[a]ttach as-is / [h]eal-all then attach / [q]uit  (default: a): " >&2
  local ans; read -r ans
  case "${ans:-a}" in
    q|Q) return 1 ;;
    h|H)
      # Bash array suffix-strip: produces ("0" "2" "3") from ("0|idle|t1" "2|dead|t2" "3|idle|t3")
      local idxs=("${issues[@]%%|*}")
      log "Healing ${#idxs[@]} pane(s) on ${target}..." >&2
      # Run yaamux --restart-dead -y on the remote — needs yaamux installed
      # there. If absent, fall back to a single tmux respawn-pane per index.
      ssh "${_REMOTE_SSH_OPTS[@]}" -- "$target" "${REMOTE_PATH_PRELUDE}
if command -v yaamux >/dev/null 2>&1; then
  YAAMUX_NO_TRIAGE=1 yaamux --restart-dead -y
else
  for i in ${idxs[@]}; do
    tmux respawn-pane -k -t '${session}:agents.'\"\$i\" 2>/dev/null || true
  done
  echo 'yaamux not installed on remote — respawned panes only; agents will not auto-relaunch.'
fi
" >&2 || warn "Remote heal failed; continuing to attach." >&2
      return 0 ;;
    *) return 0 ;;
  esac
}

# Show & explain the hosts.conf file.
_remote_hosts_show() {
  echo ""
  log "Host aliases:   ${HOSTS_CONF}"
  if [[ ! -f "$HOSTS_CONF" ]]; then
    echo ""
    echo "  No alias file yet.  Create one:"
    echo "    mkdir -p '$(dirname "$HOSTS_CONF")'"
    echo "    \$EDITOR '${HOSTS_CONF}'"
    echo ""
    echo "  Format — one alias per line:    <alias>  <ssh-target>"
    echo "  Example:"
    echo "      work    vihang@work.tail-scale.net"
    echo "      laptop  vihang@laptop.local"
    echo ""
    echo "  Then attach with:    yaamux --remote work"
    return 0
  fi
  echo ""
  printf "  %-20s  %s\n" "ALIAS" "SSH-TARGET"
  local line a t
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    [[ -z "${line// /}" ]] && continue
    read -r a t <<< "$line"
    [[ -z "$a" ]] && continue
    printf "  %-20s  %s\n" "$a" "$t"
  done < "$HOSTS_CONF"
  echo ""
  log "Use:    yaamux --remote <alias>"
}

