internal	--mobile-attach	iOS-friendly attach with one pane zoomed
internal	--mobile-grid	iPad-friendly multi-repo grid
internal	--connect	print mosh / ssh snippets and optional QR
internal	--remote	drive a session on another host (its own sub-CLI)
internal	--remote-hosts	list configured remote-host aliases
