#!/usr/bin/env bash
# =============================================================================
#  yaamux — Agents Multiplexer  (alias: ymx)
#
#  Spawn N AI coding agents in parallel, one per git worktree, in a tiled tmux
#  grid. Manage them locally or from any device. Install once, use in every repo.
#
#  Invoke as either `yaamux` or `ymx` — same script, same flags.
#  Supported agents:  claude · gemini · copilot · codex
#
#  ── Install (once) ──────────────────────────────────────────────────────────
#    git clone <yaamux-repo> ~/.yaamux
#    ~/.yaamux/yaamux --install            # symlinks yaamux into ~/.local/bin
#
#  ── Use (in any repo) ───────────────────────────────────────────────────────
#    cd ~/projects/myapp
#    yaamux                              # 4 Claude agents
#    yaamux 6                            # 6 Claude agents
#    yaamux claude gemini codex          # 3 agents, one of each
#    yaamux 8 claude gemini              # 8 agents, types cycled
#
#  ── Manage ──────────────────────────────────────────────────────────────────
#    yaamux --attach | --kill | --clean | --status | --list [--json]
#    yaamux --zoom N | --vscode N | --send N "x" | --exec N "x" | --broadcast "x"
#    yaamux --restart N | --restart-dead [-y] | --logs | --sync | --pr N [title] [--merge]
#    yaamux --watch-pr N | --auto-merge N | --ci-status [N] | --diff N
#    yaamux --setup-notify | --ssh-config | --install-service
#    yaamux --remote <host> [<session>|--list|--status|--zoom N] [--mosh|--ssh]
#    yaamux --remote-hosts | --auto-attach | --mobile-attach [<repo>] [<pane>] | --mobile-grid
#    yaamux --connect [--qr]            # print/QR the exact commands to attach from any device
#    yaamux --prepare-host [--check]    # one-time: symlink mosh-server so iOS mosh:// works (macOS Homebrew)
#    yaamux --init [--copy-skill] | --install | --update | --uninstall | --add-docs | --version | --keys
#    yaamux --agent-brief [--format markdown|text|json]   # agent-optimized CLI summary
#
#  Each repo gets its own tmux session: yaamux-<repo-name>
#  Prefix: Ctrl+Space
#
#  CAVEATS for non-Claude agents:
#    - the destructive-command guard hook protects CLAUDE panes only
#    - push notifications fire for CLAUDE panes only (hook-driven)
#
#  Copyright (c) 2026 Vihang Patel — MIT License
#  https://github.com/vihang/yaamux
# =============================================================================

set -euo pipefail

# ── Self-location (follows symlink to the real file in the yaamux repo) ─────────
SELF="$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
YAAMUX_HOME="$(dirname "$SELF")"

# ── Project context ────────────────────────────────────────────────────────────
# YAAMUX_REPO_ROOT is set per-pane in the launch loop so an agent running from
# one of its worktrees (where `git rev-parse --show-toplevel` would resolve to
# the worktree path) still sees the *main* checkout — keeping SESSION, PANELS_DIR
# and friends consistent with the user's main `yaamux --bg-list` / `--status`.
REPO_ROOT="${YAAMUX_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
PROJECT_NAME="$(basename "$REPO_ROOT")"
SESSION="yaamux-${PROJECT_NAME}"                 # one session per repo
WORKTREES_BASE="${REPO_ROOT}/../${PROJECT_NAME}-worktrees"
HOOKS_DIR="${REPO_ROOT}/.claude/hooks"
LOG_DIR="${REPO_ROOT}/.claude/logs"
NOTIFY_CONF="${HOME}/.config/yaamux/notify.conf"
HOSTS_CONF="${HOME}/.config/yaamux/hosts.conf"
MOBILE_ATTACH="${HOME}/.local/bin/yaamux-mobile-attach.sh"
CPANEL_SCRIPT="${HOME}/.local/bin/yaamux-cpanel.sh"
NOTIF_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/yaamux/notifications.log"
PANEL_CONF_GLOBAL="${HOME}/.config/yaamux/control-panel.conf"
PANEL_CONF_LOCAL="${REPO_ROOT}/.yaamux/state"
PANELS_DIR="${REPO_ROOT}/.yaamux/panels"

# ── Defaults ───────────────────────────────────────────────────────────────────
DEFAULT_AGENT="claude"
DEFAULT_COUNT=4
MAX_AGENTS=20
SCROLLBACK=50000

# ── Per-agent auto-accept flags ───────────────────────────────────────────────
# Two profiles per agent: SAFE (default — agent still prompts on risky ops) and
# YOLO (full bypass — no human in the loop). Switch to YOLO with --yolo or
# YAAMUX_YOLO=1.  Tweak either set to taste.
CLAUDE_FLAGS_SAFE=""
CLAUDE_FLAGS_YOLO="--dangerously-skip-permissions"
GEMINI_FLAGS_SAFE="--approval-mode auto_edit"
GEMINI_FLAGS_YOLO="--yolo"
COPILOT_FLAGS_SAFE="--allow-tool 'shell(git:*)'"
COPILOT_FLAGS_YOLO="--allow-all-tools"
CODEX_FLAGS_SAFE="--full-auto"
CODEX_FLAGS_YOLO="--dangerously-bypass-approvals-and-sandbox"

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; CYAN='\033[0;36m'
BOLD='\033[1m'; NC='\033[0m'

log()    { echo -e "${GREEN}[yaamux]${NC} $*"; }
warn()   { echo -e "${YELLOW}[warn]${NC} $*"; }
die()    { echo -e "${RED}[err]${NC}  $*" >&2; exit 1; }
header() { echo -e "\n${BOLD}${CYAN}── $* ${NC}"; }

# ── Agent helpers ─────────────────────────────────────────────────────────────
agent_bin()  { case "$1" in claude)echo claude;; gemini)echo gemini;;
                            copilot)echo copilot;; codex)echo codex;; *)echo "";; esac; }
agent_icon() { case "$1" in claude)echo "🤖";; gemini)echo "✦";;
                            copilot)echo "🐙";; codex)echo "⬡";; *)echo "❓";; esac; }
agent_flags() {
  # Pick per-agent flag profile based on YAAMUX_YOLO (set by --yolo or env).
  local type="$1" suffix="SAFE"
  [[ "${YAAMUX_YOLO:-0}" == "1" ]] && suffix="YOLO"
  local var
  case "$type" in
    claude)  var="CLAUDE_FLAGS_${suffix}" ;;
    gemini)  var="GEMINI_FLAGS_${suffix}" ;;
    copilot) var="COPILOT_FLAGS_${suffix}" ;;
    codex)   var="CODEX_FLAGS_${suffix}" ;;
    *)       echo ""; return ;;
  esac
  echo "${!var}"
}
agent_cmd()  {
  local type="$1" name="$2" flags
  flags="$(agent_flags "$type")"
  case "$type" in
    claude)  echo "claude ${flags} --remote-control '${PROJECT_NAME}-${name}'" ;;
    gemini)  echo "gemini ${flags}" ;;
    copilot) echo "copilot ${flags} --remote" ;;
    codex)   echo "codex ${flags}" ;;
    *)       echo "echo 'Unknown agent type: ${type}'" ;;
  esac
}
# Regex matched against the last non-empty captured line to detect "agent idle".
# Imperfect — tune per agent as their TUIs evolve. Used by --exec polling.
agent_idle_pattern() {
  case "$1" in
    claude)  echo '╰─.*─╯|^>[[:space:]]*$' ;;
    gemini)  echo '^>[[:space:]]*$|gemini>' ;;
    copilot) echo '^>[[:space:]]*$' ;;
    codex)   echo '^>[[:space:]]*$' ;;
    *)       echo '^>[[:space:]]*$' ;;
  esac
}

# ── Git host helpers ──────────────────────────────────────────────────────────
# Mirrors the agent_* triad: one switch per provider per op. Every call into a
# host CLI (gh, glab, …) goes through this family — never inline `gh`/`glab`
# elsewhere. Adding GitLab later = filling in the `gitlab)` cases here.
# Override auto-detection with $YAAMUX_GIT_HOST.

# Extract the hostname from a git remote URL. Handles https://, ssh://, and
# the bare `user@host:path` SSH form. Returns empty on unrecognized input.
# We match on the hostname (not the whole URL) so a github.com repo named
# something like "gitea-foo" doesn't get mis-detected as a Gitea forge.
_host_url_hostname() {
  local url="$1" rest
  case "$url" in
    http://*|https://*|ssh://*)
      rest="${url#*://}"     # drop scheme
      rest="${rest%%/*}"      # drop path
      rest="${rest#*@}"       # drop optional user[:pass]@ userinfo
      rest="${rest%%:*}"      # drop optional :port suffix
      echo "$rest" ;;
    *@*:*)
      rest="${url#*@}"        # drop user@
      echo "${rest%%:*}" ;;   # drop :path
    *)
      echo "" ;;
  esac
}

_host_provider() {
  [[ -n "${YAAMUX_GIT_HOST:-}" ]] && { echo "$YAAMUX_GIT_HOST"; return; }
  local url host
  url="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)"
  host="$(_host_url_hostname "$url")"
  case "$host" in
    github.com|*.github.com)                       echo github ;;
    gitlab.com|*.gitlab.com|gitlab.*)              echo gitlab ;;
    codeberg.org|gitea.com|*.codeberg.org|gitea.*) echo gitea  ;;
    *)                                             echo other  ;;
  esac
}
_host_cli() {
  case "$(_host_provider)" in
    github) echo gh   ;;
    gitlab) echo glab ;;
    *)      echo ""   ;;
  esac
}
# PR create — $1=wt $2=base $3=branch $4=title(opt). Echoes PR URL on success.
# We `cd` into the worktree before invoking the forge CLI so `gh`/`glab`/`tea`
# can resolve the repo context unambiguously — `--fill` reads commit messages
# from the current branch in cwd, so without the cd it would auto-fill from
# the wrong repo when yaamux is run from anywhere outside the worktree.
_host_pr_create() {
  local wt="$1" base="$2" head="$3" title="${4:-}" args
  case "$(_host_provider)" in
    github)
      args=(--fill --base "$base" --head "$head")
      [[ -n "$title" ]] && args+=(--title "$title")
      ( cd "$wt" && gh pr create "${args[@]}" ) ;;
    *) die "PR create not implemented for $(_host_provider). Set YAAMUX_GIT_HOST or open the PR manually." ;;
  esac
}
# PR lookup — $1=wt → echoes PR URL for the worktree's current branch.
_host_pr_url() {
  # $1=wt. Branch is passed positionally to `gh pr view` so it isn't inferred
  # from caller CWD — yaamux runs from anywhere, not the worktree. Branch
  # resolution lives inside the github arm so non-github providers still hit
  # "not implemented" cleanly (they don't need the branch at all).
  case "$(_host_provider)" in
    github)
      local branch
      branch="$(git -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null)" \
        || die "Could not resolve current branch in $1."
      [[ -n "$branch" ]] || die "Could not resolve current branch in $1."
      gh -R "$(git -C "$1" remote get-url origin)" pr view "$branch" --json url -q .url ;;
    *)      die "PR lookup not implemented for $(_host_provider)." ;;
  esac
}
_host_pr_checks_watch() {
  case "$(_host_provider)" in
    github) gh pr checks --watch "$1" ;;
    *)      die "PR checks --watch not implemented for $(_host_provider)." ;;
  esac
}
_host_pr_merge_auto() {
  case "$(_host_provider)" in
    github) gh pr merge --squash --auto "$1" ;;
    *)      die "PR auto-merge not implemented for $(_host_provider)." ;;
  esac
}
_host_pr_ci_status() {
  case "$(_host_provider)" in
    github) gh pr checks "$1" ;;
    *)      die "PR CI status not implemented for $(_host_provider)." ;;
  esac
}

# ── Path helpers ──────────────────────────────────────────────────────────────
# Normalize a path for comparison: resolve symlinks, .., trailing slashes; tolerant
# of non-existent paths. macOS BSD realpath lacks -m, so use python (always a dep).
_norm_path() {
  python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null || echo "$1"
}
# True if $1 (a worktree path) has uncommitted/untracked changes or commits
# ahead of a reasonable base branch. Used by --clean to spare in-progress work.
_worktree_is_dirty() {
  local wt="$1"
  [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]] && return 0
  local base candidate count
  for candidate in origin/HEAD origin/main origin/master main master; do
    if git -C "$wt" rev-parse --verify "$candidate" &>/dev/null; then
      base="$candidate"; break
    fi
  done
  [[ -z "${base:-}" ]] && return 1
  count="$(git -C "$wt" rev-list --count "${base}..HEAD" 2>/dev/null || echo 0)"
  [[ "$count" -gt 0 ]]
}

# True if $1 matches any existing git worktree path (after normalization).
_worktree_exists() {
  local wt_real existing existing_real
  wt_real="$(_norm_path "$1")"
  while IFS= read -r existing; do
    [[ -z "$existing" ]] && continue
    existing_real="$(_norm_path "$existing")"
    [[ "$existing_real" == "$wt_real" ]] && return 0
  done < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
  return 1
}

# Patterns from .worktreeinclude — gitignore-syntax files to copy into worktrees.
# Falls back to ".env*" if the file is missing (the historic yaamux behavior).
_read_worktree_include() {
  if [[ -f "${REPO_ROOT}/.worktreeinclude" ]]; then
    grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "${REPO_ROOT}/.worktreeinclude" 2>/dev/null
  else
    echo '.env*'
  fi
}

# Emit null-separated list of files matching .worktreeinclude patterns at $REPO_ROOT.
_collect_include_files() {
  local pattern
  while IFS= read -r pattern; do
    [[ -z "$pattern" ]] && continue
    find "$REPO_ROOT" -maxdepth 1 -name "$pattern" \
      ! -name '*.example' ! -name '*.sample' -type f -print0 2>/dev/null
  done < <(_read_worktree_include)
}

# Pick a tmux layout for N panes. Override wins if set (main|tiled|even).
# Defaults: 2=even-horizontal (side-by-side), 3/5/6=main-vertical (driver+supporting),
# 4=tiled (clean 2x2), 1 / 7+ = tiled (n=1 is a no-op anyway).
_layout_for() {
  local n="$1" override="${2:-}"
  if [[ -n "$override" ]]; then
    case "$override" in
      main)  echo "main-vertical"; return ;;
      tiled) echo "tiled"; return ;;
      even)  echo "even-horizontal"; return ;;
      *)     warn "unknown layout '$override' — using tiled"; echo "tiled"; return ;;
    esac
  fi
  case "$n" in
    2)     echo "even-horizontal" ;;
    3|5|6) echo "main-vertical" ;;
    *)     echo "tiled" ;;
  esac
}

# ── Tailscale hostname ─────────────────────────────────────────────────────────
ts_hostname() {
  command -v tailscale &>/dev/null && \
    tailscale status --json 2>/dev/null \
      | python3 -c "import sys,json; print(json.load(sys.stdin).get('Self',{}).get('DNSName','').rstrip('.'))" \
      2>/dev/null || true
}
HOST_DISPLAY="$(ts_hostname)"
[[ -z "$HOST_DISPLAY" ]] && HOST_DISPLAY="$(hostname -f 2>/dev/null || hostname)"
# Warn if hostname is local-only and notify is configured — remote push won't work.
case "$HOST_DISPLAY" in
  *.local|localhost) HOST_IS_LOCAL=true ;;
  *)                 HOST_IS_LOCAL=false ;;
esac

# ── Notify config ──────────────────────────────────────────────────────────────
[[ -f "$NOTIFY_CONF" ]] && source "$NOTIFY_CONF"
NTFY_TOPIC="${NTFY_TOPIC:-}"
NTFY_SERVER="${NTFY_SERVER:-https://ntfy.sh}"
BLINK_SNIPPET_KEY="${BLINK_SNIPPET_KEY:-yaamux-attach}"

# =============================================================================
#  Embedded helper scripts (written to disk by --setup-notify)
# =============================================================================
_write_settings_json() {
  local notify_block=""
  if [[ -f "${HOOKS_DIR}/yaamux-notify.sh" ]]; then
    notify_block=',
    "Notification": [ { "hooks": [{ "type": "command", "command": "'${HOOKS_DIR}'/yaamux-notify.sh" }] } ],
    "Stop":         [ { "hooks": [{ "type": "command", "command": "'${HOOKS_DIR}'/yaamux-notify.sh" }] } ]'
  fi
  cat > "${REPO_ROOT}/.claude/settings.json" << SETTINGS_EOF
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "${HOOKS_DIR}/yaamux-guard.sh" }]
      }
    ]${notify_block}
  }
}
SETTINGS_EOF
}

_write_guard_hook() {
  mkdir -p "$HOOKS_DIR"
  cat > "${HOOKS_DIR}/yaamux-guard.sh" << 'GUARD_EOF'
#!/usr/bin/env bash
# yaamux-guard.sh — blocks destructive shell patterns (Claude PreToolUse hook)
PATTERNS=(
  'rm[[:space:]]+-[a-zA-Z]*rf?[[:space:]]+/'
  'rm[[:space:]]+-[a-zA-Z]*rf?[[:space:]]+~'
  'rm[[:space:]]+-[a-zA-Z]*rf?[[:space:]]+\*'
  'chmod[[:space:]]+-R[[:space:]]+777'
  '>[[:space:]]*/etc/'
  '\bmkfs\b'
  'dd[[:space:]].*of=/dev/'
)
LOG="$(git rev-parse --show-toplevel 2>/dev/null || echo '.')/.claude/logs/blocked.log"
mkdir -p "$(dirname "$LOG")"
for p in "${PATTERNS[@]}"; do
  if echo "${CLAUDE_TOOL_INPUT:-}" | grep -qE "$p"; then
    echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] BLOCKED: ${CLAUDE_TOOL_INPUT:-}" >> "$LOG"
    echo "BLOCKED by yaamux-guard."; exit 2
  fi
done
exit 0
GUARD_EOF
  chmod +x "${HOOKS_DIR}/yaamux-guard.sh"
}

_write_notify_hook() {
  mkdir -p "$HOOKS_DIR"
  cat > "${HOOKS_DIR}/yaamux-notify.sh" << 'NOTIFY_EOF'
#!/usr/bin/env bash
# yaamux-notify.sh — Claude hook → ntfy push + Blink Shell deep link
# Auto-generated by: yaamux --setup-notify
set -euo pipefail

CONF="${HOME}/.config/yaamux/notify.conf"
[[ -f "$CONF" ]] && source "$CONF"
NTFY_TOPIC="${NTFY_TOPIC:-}"
NTFY_SERVER="${NTFY_SERVER:-https://ntfy.sh}"
BLINK_SNIPPET_KEY="${BLINK_SNIPPET_KEY:-yaamux-attach}"
SLACK_WEBHOOK_URL="${SLACK_WEBHOOK_URL:-}"
SSH_HOST="${SSH_HOST:-$(hostname -f 2>/dev/null || hostname)}"
SSH_USER="${SSH_USER:-$(whoami)}"
MOBILE_ATTACH="${HOME}/.local/bin/yaamux-mobile-attach.sh"
NOTIF_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/yaamux/notifications.log"

PAYLOAD="$(cat)"
HOOK_EVENT="${CLAUDE_HOOK_EVENT_NAME:-${hook_event_name:-Notification}}"
SESSION_ID="$(echo "$PAYLOAD" | python3 -c "import sys,json; print(json.load(sys.stdin).get('session_id','?')[:8])" 2>/dev/null || echo '?')"
CWD="$(echo "$PAYLOAD" | python3 -c "import sys,json; print(json.load(sys.stdin).get('cwd','?'))" 2>/dev/null || echo '?')"

# Derive project + agent + session from the worktree path
#   .../<project>-worktrees/agent-N
WT_PARENT="$(basename "$(dirname "$CWD")")"
PROJECT="${WT_PARENT%-worktrees}"
[[ "$PROJECT" == "$WT_PARENT" ]] && PROJECT="$(basename "$CWD")"
AGENT_NAME="$(basename "$CWD")"
PANE_INDEX="0"
[[ "$AGENT_NAME" =~ agent-([0-9]+) ]] && PANE_INDEX=$(( ${BASH_REMATCH[1]} - 1 ))
TMUX_SESSION="${TMUX_SESSION:-yaamux-${PROJECT}}"

case "$HOOK_EVENT" in
  Notification) ICON="🤖"; PRIORITY="high";    TITLE="${AGENT_NAME} needs input"; TAGS="robot,bell" ;;
  Stop)         ICON="✅"; PRIORITY="default"; TITLE="${AGENT_NAME} finished";    TAGS="white_check_mark" ;;
  *)            ICON="ℹ️";  PRIORITY="default"; TITLE="${AGENT_NAME}: ${HOOK_EVENT}"; TAGS="information_source" ;;
esac
BODY="Project: ${PROJECT} | Session: ${SESSION_ID}"

ATTACH_CMD="ssh -t ${SSH_USER}@${SSH_HOST} bash ${MOBILE_ATTACH} ${TMUX_SESSION} ${PANE_INDEX}"
ENCODED="$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$ATTACH_CMD")"
BLINK_URL="blinkshell://run?key=${BLINK_SNIPPET_KEY}&cmd=${ENCODED}"

# Append JSON-line to local notification log + flag the pane for status-line
# attention badge. Both consumed by the Control Panel TUI and `--status-render`.
mkdir -p "$(dirname "$NOTIF_LOG")" 2>/dev/null || true
python3 - "$NOTIF_LOG" "$TMUX_SESSION" "$PANE_INDEX" "$AGENT_NAME" "$HOOK_EVENT" "$TITLE" <<'PYNOTIF' 2>/dev/null || true
import sys, json, time
path, sess, pane, agent, event, title = sys.argv[1:7]
rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
       "session": sess, "pane": int(pane), "agent": agent,
       "event": event, "title": title}
with open(path, "a", encoding="utf-8") as f:
    f.write(json.dumps(rec, ensure_ascii=False) + "\n")
PYNOTIF
# Cheap rotation: keep last 500 lines.
if [[ -f "$NOTIF_LOG" ]] && [[ "$(wc -l < "$NOTIF_LOG" 2>/dev/null || echo 0)" -gt 500 ]]; then
  tail -n 500 "$NOTIF_LOG" > "${NOTIF_LOG}.tmp" && mv "${NOTIF_LOG}.tmp" "$NOTIF_LOG"
fi
# Set the per-pane attention bit (1 = pending). pane-focus-in hook clears it.
command -v tmux &>/dev/null && \
  tmux set-option -p -t "${TMUX_SESSION}:agents.${PANE_INDEX}" \
    @yaamux-notif-pending 1 2>/dev/null || true

if [[ -n "$NTFY_TOPIC" ]]; then
  curl -s \
    -H "Title: ${ICON} ${TITLE}" \
    -H "Priority: ${PRIORITY}" \
    -H "Tags: ${TAGS}" \
    -H "Click: ${BLINK_URL}" \
    -H "Actions: view, Open in Blink, ${BLINK_URL}" \
    -d "${BODY}" "${NTFY_SERVER}/${NTFY_TOPIC}" > /dev/null 2>&1 || true
fi
if [[ -n "$SLACK_WEBHOOK_URL" ]]; then
  COLOR="warning"; [[ "$HOOK_EVENT" == "Stop" ]] && COLOR="good"
  curl -s -X POST -H 'Content-type: application/json' \
    --data "{\"text\":\"${ICON} *${TITLE}*\n${BODY}\",\"attachments\":[{\"color\":\"${COLOR}\"}]}" \
    "$SLACK_WEBHOOK_URL" > /dev/null 2>&1 || true
fi
command -v osascript &>/dev/null && \
  osascript -e "display notification \"${BODY}\" with title \"${ICON} ${TITLE}\" sound name \"Ping\"" 2>/dev/null || true
exit 0
NOTIFY_EOF
  chmod +x "${HOOKS_DIR}/yaamux-notify.sh"
  log "Wrote ${HOOKS_DIR}/yaamux-notify.sh"
}

_write_mobile_attach() {
  mkdir -p "$(dirname "$MOBILE_ATTACH")"
  cat > "$MOBILE_ATTACH" << 'MOBILE_EOF'
#!/usr/bin/env bash
# yaamux-mobile-attach.sh — phone-sized grouped tmux viewport
# Auto-generated by: yaamux --setup-notify
# Usage: yaamux-mobile-attach.sh [SESSION] [PANE_INDEX]
set -euo pipefail
SESSION="${1:-yaamux}"
PANE_INDEX="${2:-0}"
MOB="mob-$$"
if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "❌  Session '$SESSION' not found. Start agents first: yaamux"
  exit 1
fi
tmux new-session -d -s "$MOB" -t "$SESSION" 2>/dev/null || {
  MOB="mob-$(date +%s)"; tmux new-session -d -s "$MOB" -t "$SESSION"; }
tmux select-window -t "${MOB}:agents" 2>/dev/null || tmux select-window -t "${MOB}:0" 2>/dev/null || true
tmux select-pane   -t "${MOB}:agents.${PANE_INDEX}" 2>/dev/null || true
tmux resize-pane   -t "${MOB}:agents.${PANE_INDEX}" -Z 2>/dev/null || true
tmux set-option -t "$MOB" prefix C-Space
tmux set-option -t "$MOB" status-left  "#[fg=colour46,bold] 📱 agent-$((PANE_INDEX+1)) "
tmux set-option -t "$MOB" status-right "#[fg=colour226]C connect · Q QR · D detach"
echo "📱  ${SESSION} · agent-$((PANE_INDEX+1)) — detach: Ctrl+Space + D"
trap "tmux kill-session -t '$MOB' 2>/dev/null || true" EXIT
tmux attach -t "$MOB"
MOBILE_EOF
  chmod +x "$MOBILE_ATTACH"
  log "Wrote ${MOBILE_ATTACH}"
}

# Control Panel TUI — embedded as a quoted heredoc so $() expand at runtime.
# Pure bash + ANSI 256. Polls tmux every ~1s; redraws on input.
_write_cpanel() {
  mkdir -p "$(dirname "$CPANEL_SCRIPT")"
  cat > "$CPANEL_SCRIPT" << 'CPANEL_EOF'
#!/usr/bin/env bash
# yaamux-cpanel.sh — Control Panel TUI
# Auto-generated by: yaamux. Renders sessions, panes, notifications, and a
# command menu. Selection-aware; actions fork-exec back to the yaamux binary.
set -uo pipefail

SELF_YAAMUX="${YAAMUX_SELF:-$(command -v yaamux || command -v ymx || echo yaamux)}"
SESSION="${YAAMUX_SESSION:-${TMUX_SESSION:-}}"
NOTIF_LOG="${YAAMUX_NOTIF_LOG:-${XDG_CACHE_HOME:-$HOME/.cache}/yaamux/notifications.log}"

# Default selection lives on "panes" section. Three sections cycle on Tab.
SECTION="panes"     # sessions | panes | notifs
SEL_SESSION=0
SEL_PANE=1          # 1-based agent number
SHOW_HELP=0
TICK=0

# ANSI helpers — keep it pure bash, no `tput` dependency
ESC=$'\033'
RESET="${ESC}[0m"
BOLD="${ESC}[1m"; DIM="${ESC}[2m"; INV="${ESC}[7m"
FG_GREEN="${ESC}[38;5;46m"
FG_YELLOW="${ESC}[38;5;220m"
FG_RED="${ESC}[38;5;196m"
FG_MAGENTA="${ESC}[38;5;201m"
FG_CYAN="${ESC}[38;5;81m"
FG_BLUE="${ESC}[38;5;39m"
FG_GREY="${ESC}[38;5;244m"
FG_WHITE="${ESC}[38;5;255m"

_clear()  { printf '%s[H%s[2J' "$ESC" "$ESC"; }
_goto()   { printf '%s[%d;%dH' "$ESC" "$1" "$2"; }
_hideC()  { printf '%s[?25l' "$ESC"; }
_showC()  { printf '%s[?25h' "$ESC"; }

trap '_showC; printf "\n"; exit 0' INT TERM
trap '_showC' EXIT

# Map a pane state to a glyph + color.
_state_chip() {
  case "$1" in
    running) printf '%s✓ run %s' "$FG_GREEN" "$RESET" ;;
    idle)    printf '%s⚠ idle%s' "$FG_YELLOW" "$RESET" ;;
    dead)    printf '%s✗ dead%s' "$FG_RED" "$RESET" ;;
    notify)  printf '%s! notif%s' "$FG_MAGENTA" "$RESET" ;;
    *)       printf '%s· ?   %s' "$FG_GREY" "$RESET" ;;
  esac
}

_render_header() {
  local now
  now="$(date '+%H:%M:%S' 2>/dev/null || echo '')"
  printf '%s%s yaamux control panel %s  %s%s%s   %s%s ┊ Tab: switch · Enter: act · ?: help · q: hide%s\n\n' \
    "$BOLD" "$INV" "$RESET" "$FG_CYAN" "$SESSION" "$RESET" "$DIM" "$now" "$RESET"
}

_collect_sessions() {
  tmux list-sessions -F '#{session_name}|#{session_attached}|#{session_windows}' 2>/dev/null \
    | grep '^yaamux-' || true
}

_render_sessions() {
  printf '%s── sessions (this machine) %s%s\n' "$BOLD$FG_BLUE" "$DIM" "$RESET"
  local raw line name att _w repo i=0 marker focus_marker
  raw="$(_collect_sessions)"
  if [[ -z "$raw" ]]; then
    printf '  %s(no yaamux sessions running)%s\n\n' "$DIM" "$RESET"
    return
  fi
  while IFS='|' read -r name att _w; do
    [[ -z "$name" ]] && continue
    repo="$(tmux show-option -v -t "$name" @yaamux-repo 2>/dev/null || echo '?')"
    # Mark current session; mark active selection in "sessions" section.
    marker=' '; [[ "$name" == "$SESSION" ]] && marker='*'
    focus_marker=' '
    [[ "$SECTION" == "sessions" && "$i" == "$SEL_SESSION" ]] && focus_marker='▶'
    if [[ "$att" -gt 0 ]]; then
      printf '  %s%s %s %s%-28s%s %s(attached)%s  %s\n' \
        "$FG_CYAN" "$focus_marker" "$marker" "$BOLD" "$name" "$RESET" \
        "$FG_GREEN" "$RESET" "$repo"
    else
      printf '  %s%s %s %-28s   %s\n' "$FG_GREY" "$focus_marker" "$marker" "$name" "$repo"
    fi
    i=$((i+1))
  done <<< "$raw"
  printf '%s\n' "$RESET"
}

_render_panes() {
  printf '%s── panes (current session) %s%s\n' "$BOLD$FG_BLUE" "$DIM" "$RESET"
  [[ -z "$SESSION" ]] && { printf '  %s(no session)%s\n\n' "$DIM" "$RESET"; return; }
  tmux has-session -t "$SESSION" 2>/dev/null || { printf '  %s(session gone)%s\n\n' "$DIM" "$RESET"; return; }
  local raw row idx role state notif title agent_n=0 focus_marker chip
  raw="$(tmux list-panes -t "${SESSION}:agents" -F \
    '#{pane_index}|#{@yaamux-role}|#{@yaamux-state}|#{@yaamux-notif-pending}|#{pane_title}' 2>/dev/null || true)"
  if [[ -z "$raw" ]]; then
    printf '  %s(no panes)%s\n\n' "$DIM" "$RESET"
    return
  fi
  while IFS='|' read -r idx role state notif title; do
    [[ -z "$idx" ]] && continue
    if [[ "$role" == "control-panel" ]]; then
      printf '  %s    %s· %s🎛  control-panel%s (this pane)\n' "$FG_GREY" "$FG_CYAN" "$BOLD" "$RESET"
      continue
    fi
    agent_n=$((agent_n+1))
    focus_marker=' '
    [[ "$SECTION" == "panes" && "$agent_n" == "$SEL_PANE" ]] && focus_marker='▶'
    if [[ "$notif" == "1" ]]; then chip="$(_state_chip notify)"
    else chip="$(_state_chip "${state:-?}")"; fi
    printf '  %s%s %s[%d]%s  %s  %s%s%s\n' \
      "$FG_CYAN" "$focus_marker" "$BOLD" "$agent_n" "$RESET" "$chip" \
      "$FG_WHITE" "${title:-(no title)}" "$RESET"
  done <<< "$raw"
  printf '\n'
}

_render_notifs() {
  printf '%s── notifications (last 10) %s%s\n' "$BOLD$FG_BLUE" "$DIM" "$RESET"
  if [[ ! -f "$NOTIF_LOG" ]]; then
    printf '  %s(no notifications yet — configure with: yaamux --setup-notify)%s\n\n' "$DIM" "$RESET"
    return
  fi
  local out
  out="$(tail -n 10 "$NOTIF_LOG" 2>/dev/null \
    | python3 -c '
import sys, json
for line in sys.stdin:
    line = line.strip()
    if not line: continue
    try: r = json.loads(line)
    except Exception: continue
    ts = r.get("ts", "?")[11:19]
    sess = r.get("session", "?")
    agent = r.get("agent", "?")
    ev = r.get("event", "?")
    title = r.get("title", "")
    print(f"{ts} {sess} {agent} [{ev}] {title}")
' 2>/dev/null || true)"
  if [[ -z "$out" ]]; then
    printf '  %s(empty)%s\n\n' "$DIM" "$RESET"
    return
  fi
  while IFS= read -r line; do
    printf '  %s%s%s\n' "$FG_GREY" "$line" "$RESET"
  done <<< "$out"
  printf '\n'
}

_render_menu() {
  printf '%s── menu %s%s\n' "$BOLD$FG_BLUE" "$DIM" "$RESET"
  printf '  %sr%s restart sel  %sR%s restart-dead  %sz%s zoom sel  %ss%s sync toggle\n' \
    "$BOLD" "$RESET" "$BOLD" "$RESET" "$BOLD" "$RESET" "$BOLD" "$RESET"
  printf '  %s1-9%s jump pane  %sEnter%s focus sel  %sTab%s next section  %sh/q%s hide panel\n' \
    "$BOLD" "$RESET" "$BOLD" "$RESET" "$BOLD" "$RESET" "$BOLD" "$RESET"
}

_render_help() {
  _clear
  printf '%s%s yaamux Control Panel — keys %s\n\n' "$BOLD" "$INV" "$RESET"
  printf '  %sTab%s     cycle section focus: sessions → panes → notifs\n' "$BOLD" "$RESET"
  printf '  %sj/k%s     move selection down/up (also ↑/↓)\n' "$BOLD" "$RESET"
  printf '  %sEnter%s   default action for the focused section\n' "$BOLD" "$RESET"
  printf '            sessions → switch-client to selected session\n'
  printf '            panes    → focus selected pane in current session\n\n'
  printf '  %sr%s       restart selected pane (--restart N)\n' "$BOLD" "$RESET"
  printf '  %sR%s       restart all dead/idle (--restart-dead -y)\n' "$BOLD" "$RESET"
  printf '  %sz%s       toggle zoom on selected pane\n' "$BOLD" "$RESET"
  printf '  %ss%s       toggle synchronize-panes\n' "$BOLD" "$RESET"
  printf '  %s1-9%s     jump to pane N\n' "$BOLD" "$RESET"
  printf '  %sh%s,%sq%s   hide control panel (--panel-hide)\n' "$BOLD" "$RESET" "$BOLD" "$RESET"
  printf '  %s?%s       toggle this help\n\n' "$BOLD" "$RESET"
  printf '  %s(any other key returns to the dashboard)%s\n' "$DIM" "$RESET"
}

_count_agents() {
  # `grep -c` ALREADY prints 0 on no matches but exits non-zero — so
  # `|| echo 0` appended a second "0", producing a 2-line value that
  # broke arithmetic comparisons in _dispatch. `|| true` is enough.
  tmux list-panes -t "${SESSION}:agents" -F '#{@yaamux-role}' 2>/dev/null \
    | grep -cx 'agent' 2>/dev/null || true
}

_count_sessions() {
  _collect_sessions | grep -c '.' 2>/dev/null || true
}

_session_name_at() {
  _collect_sessions | sed -n "$(( $1 + 1 ))p" | cut -d'|' -f1
}

_dispatch() {
  local key="$1" target n_agents n_sess sname
  n_agents="$(_count_agents)"
  n_sess="$(_count_sessions)"
  case "$key" in
    $'\t')
      case "$SECTION" in
        panes) SECTION=sessions ;;
        sessions) SECTION=notifs ;;
        *) SECTION=panes ;;
      esac ;;
    j|$'\x1b[B')   # down
      case "$SECTION" in
        panes)    (( SEL_PANE < n_agents )) && SEL_PANE=$((SEL_PANE+1)) ;;
        sessions) (( SEL_SESSION < n_sess-1 )) && SEL_SESSION=$((SEL_SESSION+1)) ;;
      esac ;;
    k|$'\x1b[A')   # up
      case "$SECTION" in
        panes)    (( SEL_PANE > 1 )) && SEL_PANE=$((SEL_PANE-1)) ;;
        sessions) (( SEL_SESSION > 0 )) && SEL_SESSION=$((SEL_SESSION-1)) ;;
      esac ;;
    [1-9])
      SECTION=panes
      (( key <= n_agents )) && SEL_PANE="$key" && \
        "$SELF_YAAMUX" --goto "$key" >/dev/null 2>&1 ;;
    $'\n'|'')
      case "$SECTION" in
        panes) "$SELF_YAAMUX" --goto "$SEL_PANE" >/dev/null 2>&1 ;;
        sessions)
          sname="$(_session_name_at "$SEL_SESSION")"
          [[ -n "$sname" ]] && tmux switch-client -t "$sname" 2>/dev/null || true ;;
      esac ;;
    r) "$SELF_YAAMUX" --restart "$SEL_PANE" >/dev/null 2>&1 || true ;;
    R) "$SELF_YAAMUX" --restart-dead -y >/dev/null 2>&1 || true ;;
    z) "$SELF_YAAMUX" --goto "$SEL_PANE" >/dev/null 2>&1
       tmux resize-pane -Z 2>/dev/null || true ;;
    s) # show-option reads the value; set-option (no value) errors out.
       if [[ "$(tmux show-window-option -v -t "${SESSION}:agents" synchronize-panes 2>/dev/null)" == "on" ]]; then
         tmux set-window-option -t "${SESSION}:agents" synchronize-panes off 2>/dev/null || true
       else
         tmux set-window-option -t "${SESSION}:agents" synchronize-panes on 2>/dev/null || true
       fi ;;
    h|q) "$SELF_YAAMUX" --panel-hide >/dev/null 2>&1 || true; exit 0 ;;
    \?) SHOW_HELP=$((1 - SHOW_HELP)) ;;
    *) : ;;
  esac
}

_hideC
while :; do
  _clear
  if [[ "$SHOW_HELP" == "1" ]]; then
    _render_help
  else
    _render_header
    _render_sessions
    _render_panes
    _render_notifs
    _render_menu
  fi
  TICK=$((TICK+1))
  # Block up to 1s for a key. -t 1 timeout, -rsn1 raw single char.
  if IFS= read -rsn1 -t 1 key; then
    # Capture escape sequences for arrow keys: ESC [ A/B/C/D
    if [[ "$key" == $'\x1b' ]]; then
      read -rsn2 -t 0.05 rest 2>/dev/null || rest=""
      key="$key$rest"
    fi
    _dispatch "$key"
  fi
done
CPANEL_EOF
  chmod +x "$CPANEL_SCRIPT"
  log "Wrote ${CPANEL_SCRIPT}"
}

_gen_ssh_config() {
  local f="${HOME}/.ssh/config"
  mkdir -p "$(dirname "$f")"; touch "$f"
  sed -i.bak '/# BEGIN yaamux/,/# END yaamux/d' "$f" 2>/dev/null || true
  cat >> "$f" << SSHCONF

# BEGIN yaamux
Host yaamux
  HostName      ${HOST_DISPLAY}
  User          $(whoami)
  IdentityFile  ~/.ssh/id_ed25519
  ServerAliveInterval 60
  ServerAliveCountMax 3
# END yaamux
SSHCONF
  log "SSH config written — 'ssh yaamux' works"
}

_install_launchagent() {
  local plist="${HOME}/Library/LaunchAgents/com.yaamux.${PROJECT_NAME}.plist"
  mkdir -p "$(dirname "$plist")"
  cat > "$plist" << PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.yaamux.${PROJECT_NAME}</string>
