    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>${HOME}</string>
  </dict>
</dict></plist>
PLIST_EOF
  launchctl unload "$plist" 2>/dev/null || true
  launchctl load   "$plist"
  log "LaunchAgent installed for ${PROJECT_NAME} — auto-starts on login"
}

# =============================================================================
#  Install / lifecycle commands
# =============================================================================
_is_brew_install() {
  command -v brew &>/dev/null || return 1
  local prefix
  prefix="$(brew --prefix 2>/dev/null)" || return 1
  [[ -n "$prefix" && "$SELF" == "$prefix"/* ]]
}

_show_version() {
  local version="dev" source="unknown" candidate
  # VERSION lives next to the script for git/dev installs, and under pkgshare
  # for Homebrew installs (`prefix/share/yaamux/VERSION`).
  for candidate in "${YAAMUX_HOME}/VERSION" "${YAAMUX_HOME}/../share/yaamux/VERSION"; do
    if [[ -f "$candidate" ]]; then
      version="$(cat "$candidate")"
      break
    fi
  done
  if _is_brew_install; then
    source="brew"
  elif git -C "$YAAMUX_HOME" rev-parse --git-dir &>/dev/null; then
    local sha
    sha="$(git -C "$YAAMUX_HOME" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    source="git@${sha}"
  fi
  echo "yaamux ${version} (${source})"
}

_strip_ansi() {
  python3 -c 'import re,sys; print(re.sub(r"\x1b\[[0-9;?]*[a-zA-Z]", "", sys.stdin.read()))'
}

# Send a prompt to pane IDX, poll capture-pane for the agent's idle pattern
# (stable capture + pattern match in tail-3), return captured output on idle
# or on timeout. Exits non-zero on timeout. Used by --exec.
_exec_pane() {
  local idx="$1" prompt="$2" timeout="${3:-300}"
  local type pattern agent_name
  type="$(tmux show-option -p -v -t "${SESSION}:agents.${idx}" @yaamux-type 2>/dev/null || echo "$DEFAULT_AGENT")"
  agent_name="$(tmux show-option -p -v -t "${SESSION}:agents.${idx}" @yaamux-agent 2>/dev/null || echo "agent-$((idx+1))")"
  pattern="$(agent_idle_pattern "$type")"
  tmux has-session -t "$SESSION" 2>/dev/null || { warn "No session ${SESSION}"; return 2; }
  tmux send-keys -t "${SESSION}:agents.${idx}" "$prompt" Enter
  local elapsed=0 captured="" prev=""
  sleep 1
  while [[ $elapsed -lt $timeout ]]; do
    captured="$(tmux capture-pane -p -t "${SESSION}:agents.${idx}" 2>/dev/null | _strip_ansi)"
    if [[ -n "$captured" && "$captured" == "$prev" ]] \
       && echo "$captured" | tail -3 | grep -qE "$pattern"; then
      printf '%s' "$captured"
      return 0
    fi
    prev="$captured"
    sleep 1
    elapsed=$((elapsed + 1))
  done
  warn "exec timed out after ${timeout}s for ${agent_name} (${type})"
  printf '%s' "$captured"
  return 1
}

# ── Pane health detector ──────────────────────────────────────────────────────
# Classify a pane in the "agents" window into one of:
#   running   — agent process (e.g. node) is the foreground command
#   idle      — pane process alive but foreground is the shell (agent exited)
#   dead      — pane process itself exited (pane_dead=1)
#   missing   — no pane at that index (caller should treat as terminal)
#
# We classify by foreground command, not by introspecting the agent CLI's
# state, because all four agents (claude/gemini/copilot/codex) run as `node`
# (or other non-shell), so "foreground is a shell" cleanly maps to "agent
# exited". The shell set lives on @yaamux-shells (set at start-up from $SHELL
# plus the common defaults) so the detector doesn't carry a hardcoded list.
_pane_state() {
  # Optional 2nd arg lets callers in a loop pre-fetch @yaamux-shells once
  # and pass it in, avoiding N extra tmux calls.
  local idx="$1" shells="${2:-}" raw dead cmd s role
  # Skip the control-panel pane: it isn't an agent, so it never goes "dead"
  # or "idle" in the agent-health sense.
  role="$(tmux show-option -p -v -t "${SESSION}:agents.${idx}" @yaamux-role 2>/dev/null || echo '')"
  [[ "$role" == "control-panel" ]] && { echo panel; return; }
  raw="$(tmux display-message -p -t "${SESSION}:agents.${idx}" \
        '#{pane_dead}|#{pane_current_command}' 2>/dev/null)" || { echo missing; return; }
  [[ -z "$raw" ]] && { echo missing; return; }
  dead="${raw%%|*}"; cmd="${raw#*|}"
  [[ "$dead" == "1" ]] && { echo dead; return; }
  [[ -z "$shells" ]] && \
    shells="$(tmux show-option -v -t "$SESSION" @yaamux-shells 2>/dev/null || echo 'zsh bash sh fish dash ash')"
  for s in $shells; do
    [[ "$cmd" == "$s" ]] && { echo idle; return; }
  done
  echo running
}

# Restart pane IDX (0-based) by sending C-c then re-launching its agent.
# Reads the agent type from the pane's @yaamux-type user-option, falling back
# to DEFAULT_AGENT. If the pane is dead (process exited under
# remain-on-exit), `respawn-pane -k` brings it back so send-keys can run.
_restart_pane() {
  local idx="$1" type pdead agent_name role
  tmux has-session -t "$SESSION" 2>/dev/null || die "No session for ${PROJECT_NAME}."
  # Guard against the caller passing the control-panel pane: don't relaunch
  # an agent in it (would clobber the TUI). Higher-level CLIs already filter
  # via _agent_pane_idx, but the in-tmux `prefix r` binding can hit this.
  role="$(tmux show-option -p -v -t "${SESSION}:agents.${idx}" @yaamux-role 2>/dev/null || echo '')"
  [[ "$role" == "control-panel" ]] && { warn "Refusing to restart the control-panel pane."; return 0; }
  type="$(tmux show-option -p -v -t "${SESSION}:agents.${idx}" @yaamux-type 2>/dev/null || echo '')"
  [[ -z "$type" || "$type" == "panel" ]] && type="$DEFAULT_AGENT"
  # Prefer the per-pane @yaamux-agent (stable across panel insertion); fall
  # back to the idx+1 heuristic for pre-0.2 sessions.
  agent_name="$(tmux show-option -p -v -t "${SESSION}:agents.${idx}" @yaamux-agent 2>/dev/null || echo "agent-$((idx+1))")"
  pdead="$(tmux display-message -p -t "${SESSION}:agents.${idx}" '#{pane_dead}' 2>/dev/null)"
  if [[ "$pdead" == "1" ]]; then
    # Dead pane (remain-on-exit kept it visible). Respawn brings the pane
    # process back, after which we can run the agent in it.
    tmux respawn-pane -k -t "${SESSION}:agents.${idx}" 2>/dev/null || true
  else
    tmux send-keys -t "${SESSION}:agents.${idx}" C-c "" Enter
    sleep 0.5
  fi
  log "Restarting ${agent_name} (${type})..."
  # Re-inject the per-agent YAAMUX_* env vars — the session-level set-environment
  # only reaches *new* shells (respawn-pane gives us one), but the agent-scoped
  # ones (NAME/NUMBER/TYPE/PANE_ID) aren't session-wide. Pull NUMBER back from
  # the agent name (`agent-N` → N) so manual restart matches the launch order.
  local agent_num="${agent_name#agent-}"
  local agent_total
  agent_total="$(tmux list-panes -t "${SESSION}:agents" -F '#{@yaamux-role}' 2>/dev/null \
    | grep -cx 'agent' 2>/dev/null || true)"
  [[ -z "$agent_total" || "$agent_total" == "0" ]] && agent_total="$(tmux list-panes -t "${SESSION}:agents" 2>/dev/null | wc -l | tr -d ' ')"
  local apid
  apid="$(tmux display-message -p -t "${SESSION}:agents.${idx}" '#{pane_id}' 2>/dev/null || echo '')"
  tmux send-keys -t "${SESSION}:agents.${idx}" \
    "export YAAMUX_AGENT_NAME='${agent_name}' YAAMUX_AGENT_NUMBER='${agent_num}' YAAMUX_AGENT_TOTAL='${agent_total}' YAAMUX_AGENT_TYPE='${type}' YAAMUX_SESSION='${SESSION}' YAAMUX_PANE_ID='${apid}' YAAMUX_REPO_ROOT='${REPO_ROOT}' YAAMUX_AGENT_MODE=safe; clear; $(agent_cmd "$type" "$agent_name")" Enter
  tmux set-option -p -t "${SESSION}:agents.${idx}" @yaamux-state "running" 2>/dev/null || true
}

# Pre-attach triage. Walks the named session's panes, and if any aren't
# running, prints a numbered summary + prompts the user to attach, heal,
# or quit. Returns:
#   0  proceed with attach
#   1  user picked quit
#   2  user picked heal-first; caller should call _restart_pane on each idx
# Honors YAAMUX_NO_TRIAGE=1 and non-TTY stdin (auto-proceed).
# Stores chosen-to-heal indices in the bash variable named by $2 (nameref).
_triage_prompt() {
  local session="$1" heal_var="${2:-_triage_unused}"
  [[ "${YAAMUX_NO_TRIAGE:-0}" == "1" ]] && return 0
  [[ -t 0 ]] || return 0
  tmux has-session -t "$session" 2>/dev/null || return 0
  # Save and restore SESSION for the duration so _pane_state targets the
  # right session (it reads the global).
  local prev_session="${SESSION:-}"; SESSION="$session"
  local cnt i state title shells issues=()
  cnt="$(tmux display-message -p -t "${session}:agents" '#{window_panes}' 2>/dev/null || echo 0)"
  if [[ -z "$cnt" || "$cnt" -eq 0 ]]; then SESSION="$prev_session"; return 0; fi
  shells="$(tmux show-option -v -t "$session" @yaamux-shells 2>/dev/null || echo 'zsh bash sh fish dash ash')"
  for ((i=0; i<cnt; i++)); do
    state="$(_pane_state "$i" "$shells")"
    # 'panel' = control-panel pane, never a triage candidate.
    [[ "$state" == "running" || "$state" == "missing" || "$state" == "panel" ]] && continue
    title="$(tmux display-message -p -t "${session}:agents.${i}" '#{pane_title}' 2>/dev/null)"
    issues+=("$i|$state|$title")
  done
  SESSION="$prev_session"
  [[ ${#issues[@]} -eq 0 ]] && return 0
  echo "" >&2
  warn "${#issues[@]} of ${cnt} agent panes need attention:" >&2
  local rec
  for rec in "${issues[@]}"; do
    IFS='|' read -r idx state title <<< "$rec"
    printf "  pane #%s  %-8s %s\n" "$idx" "[$state]" "$title" >&2
  done
  echo "" >&2
  echo -n "[a]ttach as-is / [h]eal-all then attach / [q]uit  (default: a): " >&2
  local ans; read -r ans
  case "${ans:-a}" in
    h|H)
      # shellcheck disable=SC2034
      eval "${heal_var}=(\"\${issues[@]%%|*}\")"   # write indices to caller's array
      return 2 ;;
    q|Q) return 1 ;;
    *)   return 0 ;;
  esac
}

# Walk every pane in the agents window, classify it, and write the result
# back to that pane's @yaamux-state user-option (consumed by the border
# format). Driven by a tmux hook on pane-exited and by status-interval.
_refresh_pane_states() {
  tmux has-session -t "$SESSION" 2>/dev/null || return 0
  local cnt i state shells
  cnt="$(tmux display-message -p -t "${SESSION}:agents" '#{window_panes}' 2>/dev/null || echo 0)"
  [[ -z "$cnt" || "$cnt" -eq 0 ]] && return 0
  shells="$(tmux show-option -v -t "$SESSION" @yaamux-shells 2>/dev/null || echo 'zsh bash sh fish dash ash')"
  for ((i=0; i<cnt; i++)); do
    state="$(_pane_state "$i" "$shells")"
    # Skip both unreachable panes (missing) and the panel pane (panel).
    [[ "$state" == "missing" || "$state" == "panel" ]] && continue
    tmux set-option -p -t "${SESSION}:agents.${i}" @yaamux-state "$state" 2>/dev/null || true
  done
}

# Resolve a 1-based agent number to its tmux pane_index. The control-panel
# pane is excluded — so "agent 1" is always the first @yaamux-role=agent pane
# regardless of where the panel sits in the index order. Echoes the resolved
# 0-based tmux pane_index or empty on failure.
_agent_pane_idx() {
  local n="${1:-}" raw idx role count=0
  [[ -z "$n" || ! "$n" =~ ^[0-9]+$ ]] && return 1
  tmux has-session -t "$SESSION" 2>/dev/null || return 1
  raw="$(tmux list-panes -t "${SESSION}:agents" \
    -F '#{pane_index}|#{@yaamux-role}' 2>/dev/null || true)"
  while IFS='|' read -r idx role; do
    [[ -z "$idx" ]] && continue
    [[ "$role" == "control-panel" ]] && continue
    count=$((count+1))
    if [[ "$count" -eq "$n" ]]; then
      echo "$idx"
      return 0
    fi
  done <<< "$raw"
  return 1
}

# Find the tmux pane_index of the control-panel pane, or empty if not present.
_panel_pane_idx() {
  tmux has-session -t "$SESSION" 2>/dev/null || return 1
  tmux list-panes -t "${SESSION}:agents" \
    -F '#{pane_index}|#{@yaamux-role}' 2>/dev/null \
    | awk -F'|' '$2=="control-panel"{print $1; exit}'
}

# Count the number of agent panes (excluding the control-panel pane).
_agent_count() {
  tmux has-session -t "$SESSION" 2>/dev/null || { echo 0; return; }
  # `grep -c` always prints a count (including 0); `|| echo 0` would
  # have appended a *second* line on no-match, producing "0\n0" which
  # blows up the arithmetic comparisons in _cpanel_show. `|| true`
  # is enough since grep already prints 0.
  tmux list-panes -t "${SESSION}:agents" -F '#{@yaamux-role}' 2>/dev/null \
    | grep -cx 'agent' || true
}

# Persist a KEY=value pair to the per-repo state file. Atomic via tmp+mv.
_save_panel_state() {
  local key="$1" val="$2" dir
  dir="$(dirname "$PANEL_CONF_LOCAL")"
  mkdir -p "$dir"
  local tmp="${PANEL_CONF_LOCAL}.tmp.$$"
  if [[ -f "$PANEL_CONF_LOCAL" ]]; then
    grep -v "^${key}=" "$PANEL_CONF_LOCAL" > "$tmp" 2>/dev/null || true
  else
    : > "$tmp"
  fi
  echo "${key}=${val}" >> "$tmp"
  mv "$tmp" "$PANEL_CONF_LOCAL"
}

# Build the control-panel pane in the current session. Caller has already
# decided the mode (tile vs sidebar). Idempotent: returns early if a panel
# pane already exists. Always persists the user's intent to the state file —
# so `yaamux --panel-show` from a shell sticks for the next session start.
_cpanel_show() {
  _save_panel_state CONTROL_PANEL_VISIBLE true
  tmux has-session -t "$SESSION" 2>/dev/null || return 0
  local existing
  existing="$(_panel_pane_idx)"
  [[ -n "$existing" ]] && return 0
  local mode n_agents
  n_agents="$(_agent_count)"
  mode="${CONTROL_PANEL_MODE:-auto}"
  if [[ "$mode" == "auto" ]]; then
    if (( n_agents % 2 == 1 )); then mode="tile"; else mode="sidebar"; fi
  fi
  case "$mode" in
    sidebar)
      tmux split-window -h -p 30 -t "${SESSION}:agents" -c "$REPO_ROOT" 2>/dev/null \
        || tmux split-window -h -t "${SESSION}:agents" -c "$REPO_ROOT" ;;
    *)
      tmux split-window -t "${SESSION}:agents" -c "$REPO_ROOT"
      tmux select-layout -t "${SESSION}:agents" tiled 2>/dev/null || true ;;
  esac
  local idx
  idx="$(tmux display-message -p -t "${SESSION}:agents" '#{window_panes}' 2>/dev/null)"
  idx=$((idx - 1))
  tmux set-option -p -t "${SESSION}:agents.${idx}" @yaamux-role control-panel 2>/dev/null || true
  tmux set-option -p -t "${SESSION}:agents.${idx}" @yaamux-type panel 2>/dev/null || true
  tmux set-option -p -t "${SESSION}:agents.${idx}" @yaamux-state panel 2>/dev/null || true
  tmux select-pane -t "${SESSION}:agents.${idx}" -T "🎛  control-panel" 2>/dev/null || true
  [[ -x "$CPANEL_SCRIPT" ]] || _write_cpanel
  tmux send-keys -t "${SESSION}:agents.${idx}" \
    "clear; YAAMUX_SELF='${SELF}' YAAMUX_SESSION='${SESSION}' YAAMUX_NOTIF_LOG='${NOTIF_LOG}' '${CPANEL_SCRIPT}'" Enter
  return 0
}

# Remove the control-panel pane and re-tile the agents. Persists intent even
# when no session is running so the next start respects the choice.
_cpanel_hide() {
  _save_panel_state CONTROL_PANEL_VISIBLE false
  tmux has-session -t "$SESSION" 2>/dev/null || return 0
  local idx
  idx="$(_panel_pane_idx)"
  [[ -z "$idx" ]] && return 0
  tmux kill-pane -t "${SESSION}:agents.${idx}" 2>/dev/null || true
  tmux select-layout -t "${SESSION}:agents" tiled 2>/dev/null || true
  return 0
}

# Flip show↔hide. With a live session, the current pane presence is the source
# of truth. Without one, fall back to the persisted state — a no-session
# `yaamux --toggle-panel` should still flip the file for the next launch.
_cpanel_toggle() {
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    local idx
    idx="$(_panel_pane_idx)"
    if [[ -n "$idx" ]]; then _cpanel_hide; else _cpanel_show; fi
  else
    if [[ "${CONTROL_PANEL_VISIBLE:-true}" == "true" ]]; then
      _cpanel_hide
    else
      _cpanel_show
    fi
  fi
}

# Recreate the panel pane if state says it should be visible but no pane
# carries the role (user manually killed it, or the session was started by
# an older yaamux that didn't know about the panel).
_cpanel_self_heal() {
  [[ "${CONTROL_PANEL_VISIBLE:-true}" == "true" ]] || return 0
  local idx
  idx="$(_panel_pane_idx)"
  [[ -n "$idx" ]] && return 0
  _cpanel_show
}

# Select the Nth agent pane (1-based). Bound to `prefix N` for 1..9.
_goto_pane() {
  local n="${1:-}" idx
  idx="$(_agent_pane_idx "$n")" || return 1
  [[ -n "$idx" ]] && tmux select-pane -t "${SESSION}:agents.${idx}" 2>/dev/null || true
}

# Emit a colored badge string for the tmux status-right. One small chip
# per agent pane: index in [], colored by state (running/idle/dead/notif).
# Notification-pending wins over state.
_status_render() {
  tmux has-session -t "$SESSION" 2>/dev/null || return 0
  local raw idx role state notif agent_n=0 out=""
  raw="$(tmux list-panes -t "${SESSION}:agents" \
    -F '#{pane_index}|#{@yaamux-role}|#{@yaamux-state}|#{@yaamux-notif-pending}' 2>/dev/null || true)"
  while IFS='|' read -r idx role state notif; do
    [[ -z "$idx" || "$role" == "control-panel" ]] && continue
    agent_n=$((agent_n+1))
    if [[ "$notif" == "1" ]]; then
      out+="#[fg=colour201,bold][${agent_n}!]#[default] "
    else
      case "$state" in
        running) out+="#[fg=colour46][${agent_n}✓]#[default] " ;;
        idle)    out+="#[fg=colour220][${agent_n}⚠]#[default] " ;;
        dead)    out+="#[fg=colour196][${agent_n}✗]#[default] " ;;
        *)       out+="#[fg=colour244][${agent_n}·]#[default] " ;;
      esac
    fi
  done <<< "$raw"
  printf '%s' "$out"
}

# ── Background panels ─────────────────────────────────────────────────────────
# A background panel is a non-agent tmux pane in a dedicated `bg` window
# running an arbitrary shell command. Output is captured to disk so any agent
# (or the user) can resume reading later via --bg-tail with a byte offset.
# Completion is detected by a per-panel sentinel emitted after the command
# returns; the sentinel embeds the exit code.
#
# Sentinel format (per-panel, unique token avoids collisions with command output):
#   [[YAAMUX:PANEL:<token>:DONE:RC=<n>]]
#
# Storage (gitignored, removed by --clean):
#   ${PANELS_DIR}/<name>.log   raw output, append-only
#   ${PANELS_DIR}/<name>.meta  KEY=value sidecar: TOKEN, PANE_ID, CMD, STARTED

_bg_meta_path() { echo "${PANELS_DIR}/${1}.meta"; }
_bg_log_path()  { echo "${PANELS_DIR}/${1}.log"; }

# Validate a panel name: alphanumerics, dash, underscore. Keeps it safe in
# paths and shell args; matches what the user can reasonably type as an arg.
_bg_validate_name() {
  local n="${1:-}"
  [[ -z "$n" ]] && { warn "bg panel name is required"; return 1; }
  [[ "$n" =~ ^[A-Za-z0-9_-]+$ ]] || { warn "bg panel name must match [A-Za-z0-9_-]+: $n"; return 1; }
  return 0
}

# Generate a random 12-char token using /dev/urandom (portable, no deps).
_bg_gen_token() {
  LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom 2>/dev/null | head -c 12
}

# Append/replace a KEY=value pair in a panel's .meta file. Atomic via tmp+mv.
_bg_save_meta() {
  local name="$1" key="$2" val="$3" path tmp
  path="$(_bg_meta_path "$name")"
  mkdir -p "$(dirname "$path")"
  tmp="${path}.tmp.$$"
  if [[ -f "$path" ]]; then
    grep -v "^${key}=" "$path" > "$tmp" 2>/dev/null || true
  else
    : > "$tmp"
  fi
  echo "${key}=${val}" >> "$tmp"
  mv "$tmp" "$path"
}

# Read a single KEY from a .meta file. Echoes the value (without "KEY=").
_bg_read_meta() {
  local name="$1" key="$2" path
  path="$(_bg_meta_path "$name")"
  [[ -f "$path" ]] || return 1
  grep -E "^${key}=" "$path" | tail -1 | cut -d= -f2-
}

# Compute status by inspecting the log for the panel's sentinel.
# Echoes `<status>|<rc>` on a single line — rc is empty when unknown.
# Callers parse via `IFS='|' read -r status rc <<< "$(_bg_status name)"`.
# Returning via stdout (not a global) survives the `$(...)` subshell barrier.
_bg_status() {
  local name="$1" token log line rc pane_id
  token="$(_bg_read_meta "$name" TOKEN 2>/dev/null || echo '')"
  log="$(_bg_log_path "$name")"
  [[ -z "$token" || ! -f "$log" ]] && { echo "unknown|"; return; }
  # Tail-scan for the per-panel sentinel; tolerate ANSI / whitespace around it.
  line="$(grep -aE "\[\[YAAMUX:PANEL:${token}:DONE:RC=[-0-9]+\]\]" "$log" 2>/dev/null | tail -1 || true)"
  if [[ -n "$line" ]]; then
    rc="$(echo "$line" | grep -oE 'RC=[-0-9]+' | tail -1 | cut -d= -f2)"
    case "$rc" in
      0)   echo "done|$rc" ;;
      130) echo "killed|$rc" ;;   # 128 + SIGINT — what `kill -INT` / Ctrl+C produces
      *)   echo "failed|$rc" ;;
    esac
    return
  fi
  # No sentinel yet. If the pane vanished, the command crashed without firing it.
  pane_id="$(_bg_read_meta "$name" PANE_ID 2>/dev/null || echo '')"
  if [[ -n "$pane_id" ]] && ! tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$pane_id"; then
    echo "failed|"
  else
    echo "running|"
  fi
}

# Lazy-create the `bg` window in the current session. Echoes the window name
# ("bg") on success; returns 1 if no session exists.
_bg_ensure_window() {
  tmux has-session -t "$SESSION" 2>/dev/null || return 1
  if ! tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx 'bg'; then
    tmux new-window -d -t "$SESSION" -n bg -c "$REPO_ROOT"
    # Normalize pane-base-index (see comment in start sequence).
    tmux set-window-option -t "${SESSION}:bg" pane-base-index 0 2>/dev/null || true
    tmux set-window-option -t "${SESSION}:bg" remain-on-exit on 2>/dev/null || true
    # First pane is a placeholder shell so the window exists even when
    # there are zero panels. Subsequent --bg invocations split off it.
    tmux select-pane -t "${SESSION}:bg.0" -T "🪟 bg (placeholder)" 2>/dev/null || true
    tmux set-option -p -t "${SESSION}:bg.0" @yaamux-role placeholder 2>/dev/null || true
  fi
  echo bg
}

# Spawn a background panel.
#   $1 — panel name
#   $2 — command string (passed verbatim to bash)
_bg_spawn() {
  local name="$1" cmd="$2" pane_id token log meta sentinel inner window placeholder_id
  _bg_validate_name "$name" || return 1
  tmux has-session -t "$SESSION" 2>/dev/null || die "No yaamux session — start one with: yaamux"
  meta="$(_bg_meta_path "$name")"
  log="$(_bg_log_path "$name")"
  if [[ -f "$meta" ]]; then
    local prev_status_rc prev_status
    prev_status_rc="$(_bg_status "$name")"
    prev_status="${prev_status_rc%%|*}"
    [[ "$prev_status" == "running" ]] && die "panel '$name' already running; --bg-kill first"
    warn "Panel '$name' exists (status=$prev_status). Overwriting log."
  fi
  mkdir -p "$PANELS_DIR"
  : > "$log"   # truncate
  token="$(_bg_gen_token)"
  sentinel="[[YAAMUX:PANEL:${token}:DONE:RC="
  window="$(_bg_ensure_window)" || return 1
  # Always target the placeholder pane explicitly. Without an explicit target,
  # tmux split-window splits whichever pane happens to be active in the bg
  # window — after the first --bg call, that's the previous panel, and the
  # tiled layout fragments unpredictably as we keep spawning.
  placeholder_id="$(tmux list-panes -t "${SESSION}:${window}" -F '#{pane_id}|#{@yaamux-role}' 2>/dev/null \
    | awk -F'|' '$2=="placeholder"{print $1; exit}')"
  if [[ -z "$placeholder_id" ]]; then
    # Defensive: placeholder is created by _bg_ensure_window; if it went
    # missing, fall back to the window itself (tmux picks the active pane).
    placeholder_id="${SESSION}:${window}"
  fi
  # Create the pane WITHOUT a command so we can attach pipe-pane FIRST.
  # The old design did `split-window … "$wrapper"` and then `pipe-pane` —
  # for fast-exit commands the sentinel could be emitted before the pipe
  # attached, leaving the panel stuck in 'running' forever.
  pane_id="$(tmux split-window -t "$placeholder_id" -P -F '#{pane_id}' -c "$REPO_ROOT" 2>/dev/null)"
  [[ -z "$pane_id" ]] && die "split-window failed when creating bg panel '$name'."
  tmux set-option -p -t "$pane_id" @yaamux-role background 2>/dev/null || true
  tmux set-option -p -t "$pane_id" @yaamux-panel-name "$name" 2>/dev/null || true
  tmux select-pane -t "$pane_id" -T "🪟 ${name}" 2>/dev/null || true
  # Pipe-pane is now attached BEFORE the command runs — race window closed.
  tmux pipe-pane -t "$pane_id" -o "cat >> '${log}'"
  # Send the wrapper to the pane's idle shell. Outer shell remains afterward
  # for the user to inspect / rerun. set -o pipefail makes rc reflect any
  # mid-pipeline failure in the user's command.
  inner="set -o pipefail; ${cmd}; rc=\$?; printf '\\n%s%d]]\\n' '${sentinel}' \"\$rc\""
  tmux send-keys -t "$pane_id" "$inner" Enter
  tmux select-layout -t "${SESSION}:${window}" tiled 2>/dev/null || true
  _bg_save_meta "$name" TOKEN   "$token"
  _bg_save_meta "$name" PANE_ID "$pane_id"
  _bg_save_meta "$name" CMD     "$cmd"
  _bg_save_meta "$name" STARTED "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  log "Spawned bg panel '${name}' (pane=${pane_id})"
  echo "Tail with: yaamux --bg-tail ${name}"
}

# Tail a panel's log. Honors --from <offset> and --follow.
# Output: raw log bytes, then a trailing "OFFSET=<n>" line, then
# "STATUS=<status>" (and "RC=<n>" if applicable).
_bg_tail() {
  local name="$1"; shift
  local from=0 follow=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)   from="$2"; shift 2 ;;
      --follow) follow=true; shift ;;
      *) die "Unknown --bg-tail option: $1" ;;
    esac
  done
  _bg_validate_name "$name" || return 1
  local log; log="$(_bg_log_path "$name")"
  [[ -f "$log" ]] || die "No such panel: $name (log not found)"
  # Print bytes from $from to end.
  local size token sentinel_re
  size="$(wc -c < "$log" | tr -d ' ')"
  if [[ "$from" -lt "$size" ]]; then
    tail -c "+$((from + 1))" "$log"
  fi
  if $follow; then
    # Stream new bytes until the sentinel appears (or the file goes away).
    token="$(_bg_read_meta "$name" TOKEN 2>/dev/null || echo '')"
    sentinel_re="\[\[YAAMUX:PANEL:${token}:DONE:RC=[-0-9]+\]\]"
    # tail -f from current end; awk exits on sentinel match.
    tail -c "+$((size + 1))" -f "$log" 2>/dev/null \
      | awk -v re="$sentinel_re" '{print; if ($0 ~ re) exit}'
    size="$(wc -c < "$log" | tr -d ' ')"
  fi
  local status_rc status rc
  status_rc="$(_bg_status "$name")"
  status="${status_rc%%|*}"
  rc="${status_rc#*|}"
  printf 'OFFSET=%s\n' "$size"
  printf 'STATUS=%s\n' "$status"
  [[ -n "$rc" ]] && printf 'RC=%s\n' "$rc"
  return 0
}

# List all background panels. Format: human (default) or json.
_bg_list() {
  local fmt="${1:-human}"
  shopt -s nullglob
  local metas=("${PANELS_DIR}"/*.meta) m name cmd started pane_id status rc log_size
  shopt -u nullglob
  if [[ ${#metas[@]} -eq 0 ]]; then
    if [[ "$fmt" == "json" ]]; then echo "[]"; else log "No background panels."; fi
    return 0
  fi
  if [[ "$fmt" == "json" ]]; then
    # Build TSV then pipe through python for safe escaping.
    local tsv="" status_rc
    for m in "${metas[@]}"; do
      name="$(basename "$m" .meta)"
      cmd="$(_bg_read_meta "$name" CMD 2>/dev/null || echo '')"
      started="$(_bg_read_meta "$name" STARTED 2>/dev/null || echo '')"
      pane_id="$(_bg_read_meta "$name" PANE_ID 2>/dev/null || echo '')"
      status_rc="$(_bg_status "$name")"
      status="${status_rc%%|*}"; rc="${status_rc#*|}"
      log_size="$(wc -c < "$(_bg_log_path "$name")" 2>/dev/null | tr -d ' ' || echo 0)"
      tsv+="${name}	${status}	${rc}	${pane_id}	${log_size}	${started}	${cmd}"$'\n'
    done
    printf '%s' "$tsv" | python3 -c '
import json, sys
items = []
for line in sys.stdin.read().splitlines():
    if not line: continue
    parts = line.split("\t")
    if len(parts) < 7: continue
    rc = parts[2]
    items.append({"name": parts[0], "status": parts[1],
                  "rc": (int(rc) if rc else None),
                  "pane_id": parts[3], "log_size": int(parts[4] or 0),
                  "started": parts[5], "cmd": parts[6]})
print(json.dumps(items, indent=2))
'
  else
    printf "%-20s %-10s %-8s %-8s %-22s %s\n" NAME STATUS RC PANE STARTED CMD
    local status_rc
    for m in "${metas[@]}"; do
      name="$(basename "$m" .meta)"
      cmd="$(_bg_read_meta "$name" CMD 2>/dev/null || echo '')"
      started="$(_bg_read_meta "$name" STARTED 2>/dev/null || echo '')"
      pane_id="$(_bg_read_meta "$name" PANE_ID 2>/dev/null || echo '')"
      status_rc="$(_bg_status "$name")"
      status="${status_rc%%|*}"; rc="${status_rc#*|}"; [[ -z "$rc" ]] && rc="-"
      printf "%-20s %-10s %-8s %-8s %-22s %s\n" \
        "$name" "$status" "$rc" "$pane_id" "$started" "$cmd"
    done
  fi
}

# Kill a background panel: send Ctrl-C, wait briefly, then kill the pane.
# Preserves the log + meta on disk so --bg-tail still works.
_bg_kill() {
  local name="$1" pane_id status_rc status
  _bg_validate_name "$name" || return 1
  pane_id="$(_bg_read_meta "$name" PANE_ID 2>/dev/null || echo '')"
  [[ -z "$pane_id" ]] && die "No such panel: $name"
  status_rc="$(_bg_status "$name")"
  status="${status_rc%%|*}"
  if [[ "$status" != "running" ]]; then
    warn "Panel '$name' is not running (status=$status) — nothing to kill."
    return 0
  fi
  if tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$pane_id"; then
    tmux send-keys -t "$pane_id" C-c 2>/dev/null || true
    sleep 0.5
    # If still alive, force-kill. The pane disappears; status() will report
    # 'failed' next call (sentinel not present + pane gone).
    if tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$pane_id"; then
      tmux kill-pane -t "$pane_id" 2>/dev/null || true
    fi
  fi
  log "Killed bg panel '${name}'."
}

_pr_pane() {
  local idx="$1" title="${2:-}" merge="${3:-false}"
  local agent="agent-$((idx+1))"
  local branch="worktree/${agent}"
  local wt="${WORKTREES_BASE}/${agent}"
  local cli; cli="$(_host_cli)"
  [[ -n "$cli" ]] || die "No git host CLI configured (provider: $(_host_provider))."
  command -v "$cli" &>/dev/null || die "${cli} not found — brew install ${cli}; ${cli} auth login"
  [[ -d "$wt" ]] || die "Worktree $wt not found."
  local base="${YAAMUX_DEFAULT_BASE:-origin/main}"; base="${base#origin/}"
  log "Pushing ${branch} to origin..."
  git -C "$wt" push -u origin "$branch" || die "git push failed."
  log "Creating PR (base: ${base})..."
  local pr_url
  pr_url="$(_host_pr_create "$wt" "$base" "$branch" "$title")" || die "PR create failed."
  echo "$pr_url"
  if [[ "$merge" == "true" ]]; then
    log "Enabling auto-merge (squash)..."
    _host_pr_merge_auto "$pr_url" || die "auto-merge failed."
    log "Auto-merge enabled. Run 'yaamux --clean' after merge completes to remove the worktree."
  fi
}

# Resolve a 0-based agent ordinal to "wt|branch|pr_url". Does NOT consult tmux —
# the disk-based agent-N convention is independent of where any tmux pane sits
# (same rationale as --pr's comment above).
# stderr from _host_pr_url is intentionally NOT suppressed so the underlying
# error (e.g. "PR lookup not implemented for gitlab" or gh's "no pull requests
# found for branch …") reaches the user; we just add the follow-up hint.
_pane_pr() {
  local idx="$1" wt branch url
  wt="${WORKTREES_BASE}/agent-$((idx+1))"
  branch="worktree/agent-$((idx+1))"
  [[ -d "$wt" ]] || die "Worktree $wt not found."
  url="$(_host_pr_url "$wt")" \
    || die "No PR for ${branch} (open one with: yaamux --pr $((idx+1)))"
  echo "${wt}|${branch}|${url}"
}
