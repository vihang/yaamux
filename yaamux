_brief_json() {
  local version="${YAAMUX_VERSION:-}"
  if [[ -z "$version" ]]; then
    local c
    for c in "${YAAMUX_HOME}/VERSION" "${YAAMUX_HOME}/../share/yaamux/VERSION"; do
      [[ -f "$c" ]] && { version="$(cat "$c")"; break; }
    done
    version="${version:-dev}"
  fi
  # Pipe TSV + envelope vars to python for safe escaping. Exports (not the
  # `VAR=val cmd` form) so the values reach python at the *end* of the pipe.
  export YAAMUX_VERSION_PASS="$version"
  export YAAMUX_AGENT_NAME_PASS="${YAAMUX_AGENT_NAME:-}"
  export YAAMUX_AGENT_NUMBER_PASS="${YAAMUX_AGENT_NUMBER:-}"
  export YAAMUX_AGENT_TOTAL_PASS="${YAAMUX_AGENT_TOTAL:-}"
  export YAAMUX_AGENT_TYPE_PASS="${YAAMUX_AGENT_TYPE:-}"
  export YAAMUX_SESSION_PASS="${YAAMUX_SESSION:-}"
  export YAAMUX_PANE_ID_PASS="${YAAMUX_PANE_ID:-}"
  export YAAMUX_REPO_ROOT_PASS="${YAAMUX_REPO_ROOT:-}"
  export YAAMUX_AGENT_MODE_PASS="${YAAMUX_AGENT_MODE:-}"
  _brief_data | python3 -c '
import json, os, sys
def maybe_int(s):
    if s == "": return None
    try: return int(s)
    except ValueError: return s
commands = []
for line in sys.stdin.read().splitlines():
    if not line: continue
    parts = line.split("\t")
    if len(parts) < 3: continue
    group, flag, summary = parts[0], parts[1], parts[2]
    if group in ("internal", "setup"): continue
    commands.append({"group": group, "flag": flag, "summary": summary})
out = {
    "version": os.environ.get("YAAMUX_VERSION_PASS", ""),
    "in_session": bool(os.environ.get("YAAMUX_SESSION_PASS", "")),
    "agent": {
        "name":      os.environ.get("YAAMUX_AGENT_NAME_PASS", "") or None,
        "number":    maybe_int(os.environ.get("YAAMUX_AGENT_NUMBER_PASS", "")),
        "total":     maybe_int(os.environ.get("YAAMUX_AGENT_TOTAL_PASS", "")),
        "type":      os.environ.get("YAAMUX_AGENT_TYPE_PASS", "") or None,
        "session":   os.environ.get("YAAMUX_SESSION_PASS", "") or None,
        "pane_id":   os.environ.get("YAAMUX_PANE_ID_PASS", "") or None,
        "repo_root": os.environ.get("YAAMUX_REPO_ROOT_PASS", "") or None,
        "mode":      os.environ.get("YAAMUX_AGENT_MODE_PASS", "") or None,
    },
    "commands": commands,
}
print(json.dumps(out, indent=2))
'
}

_emit_brief() {
  local format="markdown"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format) format="${2:?--format needs value: markdown|text|json}"; shift 2 ;;
      --format=*) format="${1#--format=}"; shift ;;
      *) die "Unknown --agent-brief arg: $1 (try: --format markdown|text|json)" ;;
    esac
  done
  case "$format" in
    md|markdown) _brief_markdown ;;
    txt|text)    _brief_text ;;
    json)        _brief_json ;;
    *) die "Unknown --agent-brief --format: $format (try: markdown|text|json)" ;;
  esac
}

_remote_help() {
  cat << HELP
yaamux --remote — operate on yaamux sessions over SSH

Usage:
  yaamux --remote <host>                       Pick a session and attach (numbered prompt)
  yaamux --remote <host> <session-or-repo>     Attach directly  (myapp → yaamux-myapp)
  yaamux --remote <host> --list [--json]       List yaamux-* sessions on the host
  yaamux --remote <host> --status [<session>]  Windows/panes status — no attach
  yaamux --remote <host> --zoom N [<session>]  Attach with pane N zoomed (great for phones)
  yaamux --remote-hosts                        Show host aliases configured locally

Transport (attach / --zoom only, or set YAAMUX_MOSH=1):
  --ssh    Use 'ssh -t' for attach   (default — reliable, no deps on the remote)
  --mosh   Use mosh for attach        (survives sleep / network drops — ideal for phones)
  (--list and --status always use ssh; they're one-shot queries and don't benefit from mosh.)

<host> is a bare ssh target (user@host) or an alias from:
  ${HOSTS_CONF}

  Format — one per line:    <alias>  <ssh-target>
  Example:
      work    vihang@work.tail-scale.net
      laptop  vihang@laptop.local

Requires 'tmux' on the remote (and 'mosh-server' + 'sh' if you use --mosh).
yaamux itself does not need to be installed there.
HELP
}

# Dispatch --remote subcommands.   Args after '--remote' are passed verbatim.
_remote_dispatch() {
  # Make sure the ssh ControlPath dir exists — sockets only created on demand
  # but ssh needs the parent dir to be writable up front. Let mkdir's error
  # surface if creation fails (matches the other mkdir -p calls in this file).
  mkdir -p "$_REMOTE_SSH_SOCK_DIR"

  local use_mosh="${YAAMUX_MOSH:-0}"
  local args=() a
  for a in "$@"; do
    case "$a" in
      --mosh) use_mosh=1 ;;
      --ssh)  use_mosh=0 ;;
      *)      args+=("$a") ;;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"
  export YAAMUX_USE_MOSH="$use_mosh"

  local raw_host="${1:-}"
  if [[ -z "$raw_host" || "$raw_host" == "--help" || "$raw_host" == "-h" ]]; then
    _remote_help; return 0
  fi
  shift
  local target; target="$(_remote_resolve_host "$raw_host")"
  [[ -z "$target" ]] && die "--remote needs a host or alias."
  # Guard against ssh/mosh option-injection if the resolved target starts with '-'.
  case "$target" in -*) die "Refusing ssh/mosh target that starts with '-': ${target}" ;; esac

  case "${1:-}" in
    --list)
      local fmt="human"; [[ "${2:-}" == "--json" ]] && fmt="json"
      _remote_print_list "$target" "$fmt" ;;
    --status)
      local sess="${2:-}"
      [[ -z "$sess" ]] && { sess="$(_remote_pick_session "$target")" || return 1; }
      sess="$(_remote_normalize_session "$sess")"
      case "$sess" in *\'*|*\"*|*\\*|*\;*) die "Invalid session name." ;; esac
      header "remote status: ${target} :: ${sess}"
      # awk on the remote classifies each pane the same way _pane_state does locally:
      # dead=1 → dead; foreground command in the shell set → idle; else running.
      ssh "${_REMOTE_SSH_OPTS[@]}" -- "$target" "${REMOTE_PATH_PRELUDE}
tmux list-windows -t '${sess}' 2>/dev/null || echo '  (session not found)'
echo
shells=\"\$(tmux show-option -v -t '${sess}' @yaamux-shells 2>/dev/null || echo 'zsh bash sh fish dash ash')\"
tmux list-panes -t '${sess}:agents' -F '#{pane_index}|#{pane_title}|#{pane_dead}|#{pane_current_command}' 2>/dev/null \\
  | awk -F'|' -v sh=\"\$shells\" '
    BEGIN { n = split(sh, s, /[ \\t]+/); for (i=1;i<=n;i++) is_shell[s[i]] = 1 }
    {
      st = (\$3 == 1) ? \"dead\" : (is_shell[\$4] ? \"idle\" : \"running\")
      printf \"  pane #%s: %s  state=%s\\n\", \$1, \$2, st
    }'
" ;;
    --zoom)
      local n="${2:-}"
      [[ -z "$n" ]] && die "Usage: yaamux --remote <host> --zoom N [session]"
      [[ "$n" =~ ^[1-9][0-9]*$ ]] || die "--zoom needs a numeric pane index (1-based)."
      local sess="${3:-}"
      [[ -z "$sess" ]] && { sess="$(_remote_pick_session "$target")" || return 1; }
      sess="$(_remote_normalize_session "$sess")"
      _remote_attach "$target" "$sess" "$((n-1))" ;;
    --help|-h) _remote_help ;;
    "")
      local sess
      sess="$(_remote_pick_session "$target")" || return 1
      _remote_attach "$target" "$sess" ;;
    --*)
      die "Unknown --remote sub-flag: $1   (try: yaamux --remote --help)" ;;
    *)
      local sess; sess="$(_remote_normalize_session "$1")"
      _remote_attach "$target" "$sess" ;;
  esac
}

# =============================================================================
#  Argument parsing
# =============================================================================
# Pre-extract global modifiers (--yolo, --layout) that combine with positional args.
REMAINING=()
YAAMUX_YOLO="${YAAMUX_YOLO:-0}"
YAAMUX_LAYOUT="${YAAMUX_LAYOUT:-}"
YAAMUX_LINK_ENV="${YAAMUX_LINK_ENV:-0}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --yolo)       YAAMUX_YOLO=1 ;;
    --layout)     YAAMUX_LAYOUT="${2:?--layout needs value: main|tiled|even}"; shift ;;
    --layout=*)   YAAMUX_LAYOUT="${1#--layout=}" ;;
    --link-env)   YAAMUX_LINK_ENV=1 ;;
    *)            REMAINING+=("$1") ;;
  esac
  shift
done
set -- "${REMAINING[@]+"${REMAINING[@]}"}"
export YAAMUX_YOLO YAAMUX_LAYOUT YAAMUX_LINK_ENV

# Positional form:  yaamux [N] [type ...]   |   Flag form:  yaamux --xxx
AGENT_TYPES=(); N=""; PATTERN=()
if [[ -n "${1:-}" && "${1:0:2}" != "--" ]]; then
  if [[ "$1" =~ ^[0-9]+$ ]]; then N="$1"; shift; fi
  PATTERN=("$@")
  shift $# 2>/dev/null || true
fi

# ── Safe-mode guard ────────────────────────────────────────────────────────────
# YAAMUX_AGENT_MODE=safe is set per-pane in the launch loop. Agents reading the
# scaffolded AGENTS.md learn the CLI surface; this guard makes sure a curious
# agent can't `--kill` its own session or `--clean --force` away its siblings.
# The user's own shell outside the session sees no change since the var isn't
# exported there.
if [[ "${YAAMUX_AGENT_MODE:-}" == "safe" ]]; then
  case "${1:-}" in
    --kill|--clean|--uninstall|--install|--install-service)
      die "Flag $1 is disabled in agent mode (YAAMUX_AGENT_MODE=safe). Ask the operator to run this from their own shell." ;;
  esac
fi

# ── Flag commands ──────────────────────────────────────────────────────────────
case "${1:-}" in
  --install)        _install_yaamux;        exit 0 ;;
  --update)         _update_yaamux;         exit 0 ;;
  --uninstall)      _uninstall_yaamux;      exit 0 ;;
  --add-docs)       _add_docs;            exit 0 ;;
  --init)           shift; _init_repo "$@"; exit 0 ;;
  --version)        _show_version;          exit 0 ;;
  --keys)           _print_keys;            exit 0 ;;

  # Agent brief — agent-optimized CLI summary (issue #29 Tier 2). Kept in lockstep
  # with the case block via the _brief_data source-of-truth table; bats drift
  # guard verifies every flag is catalogued.
  --agent-brief)
    shift
    _emit_brief "$@"
    exit 0 ;;

  # Control Panel — TUI pane that shows global state and runs commands by menu.
  --cpanel)
    # Internal: run the TUI in the current pane. Called by --panel-show and
    # the prefix-p binding via send-keys; idempotent re-launch is safe.
    [[ -x "$CPANEL_SCRIPT" ]] || _write_cpanel
    YAAMUX_SELF="$SELF" YAAMUX_SESSION="$SESSION" YAAMUX_NOTIF_LOG="$NOTIF_LOG" \
      exec "$CPANEL_SCRIPT" ;;
  --panel-show)     _cpanel_show;           exit 0 ;;
  --panel-hide)     _cpanel_hide;           exit 0 ;;
  --toggle-panel)   _cpanel_toggle;         exit 0 ;;
  --cpanel-self-heal) _cpanel_self_heal;    exit 0 ;;

  # Internal: render per-pane status badges (consumed by tmux status-right).
  --status-render)
    _status_render
    exit 0 ;;

  # Internal: jump to the Nth agent pane (1-based). Bound to prefix 1..9.
  --goto)
    _goto_pane "${2:-}"
    exit 0 ;;

  # Background panels — non-agent panes for long-running shell commands. See
  # `_bg_*` helpers + YAAMUX.md "Background panels". Closes #1.
  --bg)
    NAME="${2:?Usage: yaamux --bg <name> \"<cmd>\"}"
    CMD="${3:?Usage: yaamux --bg <name> \"<cmd>\"}"
    _bg_spawn "$NAME" "$CMD"
    exit $? ;;

  --bg-tail)
    NAME="${2:?Usage: yaamux --bg-tail <name> [--from N] [--follow]}"
    shift 2
    _bg_tail "$NAME" "$@"
    exit $? ;;

  --bg-list)
    FMT="human"; [[ "${2:-}" == "--json" ]] && FMT="json"
    _bg_list "$FMT"
    exit $? ;;

  --bg-kill)
    NAME="${2:?Usage: yaamux --bg-kill <name>}"
    _bg_kill "$NAME"
    exit $? ;;

  --list)
    fmt="human"; [[ "${2:-}" == "--json" ]] && fmt="json"
    _list_sessions "$fmt"; exit 0 ;;

  --exec)
    N_ARG="${2:?Usage: yaamux --exec N \"prompt\" [timeout_seconds]}"
    IDX="$(_agent_pane_idx "$N_ARG")" || die "agent $N_ARG not found."
    PROMPT="${3:?Usage: yaamux --exec N \"prompt\" [timeout_seconds]}"
    TIMEOUT="${4:-300}"
    _exec_pane "$IDX" "$PROMPT" "$TIMEOUT"
    exit $? ;;

  --pr)
    # --pr operates on the worktree path (agent-N), not a tmux pane — so we
    # pass the 0-based agent ordinal (N-1) regardless of where the pane sits.
    N_ARG="${2:?Usage: yaamux --pr N [title] [--merge]}"
    IDX=$(( N_ARG - 1 ))
    TITLE=""; MERGE=false
    for arg in "${@:3}"; do
      case "$arg" in
        --merge) MERGE=true ;;
        *) [[ -z "$TITLE" ]] && TITLE="$arg" ;;
      esac
    done
    _pr_pane "$IDX" "$TITLE" "$MERGE"
    exit $? ;;

  --watch-pr)
    # Same disk-based convention as --pr: 0-based agent ordinal, independent
    # of tmux pane positions (so the Control Panel pane doesn't shift things).
    N_ARG="${2:?Usage: yaamux --watch-pr N}"
    [[ "$N_ARG" =~ ^[1-9][0-9]*$ ]] || die "Usage: yaamux --watch-pr N (N must be a positive integer; got '${N_ARG}')"
    _watch_pr_pane "$(( N_ARG - 1 ))"; exit $? ;;

  --auto-merge)
    N_ARG="${2:?Usage: yaamux --auto-merge N}"
    [[ "$N_ARG" =~ ^[1-9][0-9]*$ ]] || die "Usage: yaamux --auto-merge N (N must be a positive integer; got '${N_ARG}')"
    _auto_merge_pane "$(( N_ARG - 1 ))"; exit $? ;;

  --ci-status)
    if [[ -n "${2:-}" ]]; then
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || die "Usage: yaamux --ci-status [N] (N must be a positive integer; got '$2')"
      _ci_status_pane "$(( $2 - 1 ))"; exit $?
    else
      # No N — iterate every worktree on disk. Subshell isolates die() inside
      # _pane_pr so one missing PR doesn't abort the loop.
      for ((i=0; i<MAX_AGENTS; i++)); do
        [[ -d "${WORKTREES_BASE}/agent-$((i+1))" ]] || continue
        printf '\n── agent-%d ──\n' "$((i+1))"
        ( _ci_status_pane "$i" 2>&1 ) || true
      done
      exit 0
    fi ;;

  --diff)
    N_ARG="${2:?Usage: yaamux --diff N}"
    [[ "$N_ARG" =~ ^[1-9][0-9]*$ ]] || die "Usage: yaamux --diff N (N must be a positive integer; got '${N_ARG}')"
    _diff_pane "$(( N_ARG - 1 ))"; exit $? ;;

  --ssh-config)     _gen_ssh_config;      exit 0 ;;
  --install-service) _install_launchagent; exit 0 ;;
  --prepare-host)   _prepare_host_mosh "${2:-apply}"; exit $? ;;

  --remote)
    shift
    _remote_dispatch "$@"
    exit $? ;;

  --remote-hosts)   _remote_hosts_show;    exit 0 ;;

  --attach) tmux attach -t "$SESSION" 2>/dev/null || die "No session for ${PROJECT_NAME}."; exit 0 ;;

  --connect)
    # Print the exact commands anyone can use to reach this host's yaamux
    # sessions — designed to be shown inside the session (via `prefix C`
    # display-popup) or run on the host so the user can grab the line.
    # With --qr, also renders an ANSI-UTF8 QR that encodes a mosh:// URL
    # (Blink / Prompt 3 / Termius handle the scheme).  We deliberately do
    # NOT encode the raw shell snippet — iOS would parse `user@host.tld`
    # as an email address and open Mail.app instead of the terminal.
    shift
    _c_qr=false
    case "${1:-}" in --qr|--qrcode) _c_qr=true ;; esac
    _c_user="$(whoami)"
    _c_host="${HOST_DISPLAY}"
    _c_cmd_mosh="mosh --server='${MOSH_SERVER_CMD}' ${_c_user}@${_c_host} -- yaamux --auto-attach"
    _c_cmd_ssh="ssh -t ${_c_user}@${_c_host} 'yaamux --auto-attach'"
    _c_cmd_remote="yaamux --remote ${_c_user}@${_c_host}"
    # QR payload: mosh:// URL scheme — iOS Vision recognizes it as a URL
    # (Blink / Prompt 3 / Termius register the scheme) and offers a one-tap
    # "Open in <terminal>" action. Encoding the raw shell command instead
    # makes iOS see `user@host.tld` as an email and offer Mail.app, which
    # is wrong every time.
    _c_qr_payload="mosh://${_c_user}@${_c_host}"
    printf '\n  ── yaamux connect (%s) ─────────────────────────────────\n\n' "$_c_host"
    echo "  Sessions running:"
    if tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -qE '^yaamux-'; then
      tmux list-sessions -F '    · #{session_name}  (#{session_windows} window, attached: #{session_attached})' 2>/dev/null | grep yaamux- || true
    else
      echo "    (none — start one with: yaamux)"
    fi
    echo ""
    printf '  %biOS / iPad / iPhone%b — Blink, Prompt 3 (mosh, sleep-safe, auto UI):\n' "$BOLD" "$NC"
    printf '    %s\n\n' "$_c_cmd_mosh"
    printf '  %bSSH fallback%b (no mosh on remote):\n' "$BOLD" "$NC"
    printf '    %s\n\n' "$_c_cmd_ssh"
    printf '  %bDesktop%b — yaamux installed on the client:\n' "$BOLD" "$NC"
    printf '    %s\n\n' "$_c_cmd_remote"
    # Pre-flight: warn if the QR's `mosh://` URL would fail on this host
    # (mosh-server off ssh's non-interactive PATH — typical on macOS Homebrew).
    # The full mosh snippet above still works because it bakes --server=, but
    # the QR scan doesn't, so surface the one-line fix before users scan.
    if command -v mosh &>/dev/null && ! _mosh_server_on_default_path; then
      printf '  %bHeads up%b — mosh-server is off ssh'\''s default PATH on this host.\n' "$YELLOW" "$NC"
      printf '    The full mosh line above still works (bakes the PATH fix).\n'
      printf '    The QR / mosh://user@host below will hit NoMoshServerArgs until you run:\n'
      printf '      %byaamux --prepare-host%b   (one-time, sudo — symlinks /usr/local/bin/mosh-server)\n\n' "$BOLD" "$NC"
    fi
    if $_c_qr; then
      if command -v qrencode &>/dev/null; then
        printf '  %bQR%b — scan with iOS Camera → tap result → opens in Blink / Prompt 3 / Termius:\n' "$BOLD" "$NC"
        printf '    (encodes %s — run  yaamux --auto-attach  once connected)\n' "$_c_qr_payload"
        qrencode -t ansiutf8 -- "$_c_qr_payload"
        echo ""
      else
        warn "qrencode not installed — brew install qrencode  (then re-run with --qr)"
      fi
    elif command -v qrencode &>/dev/null; then
      echo "  QR:  yaamux --connect --qr   (or  Ctrl+Space Q  from inside a yaamux session)"
    else
      echo "  QR:  brew install qrencode   (then: yaamux --connect --qr)"
    fi
    exit 0 ;;


  --auto-attach)
    # One snippet body that DTRT on phone, iPad, or desktop.  Detects the
    # client terminal's width and routes to --mobile-attach (zoom one pane),
    # --mobile-grid (multi-repo iPad grid), or a regular tmux attach.  Set
    # YAAMUX_ATTACH_MODE=zoom|grid|full to override when auto guesses wrong
    # (e.g. a narrow tmux pane on a desktop).
    _aa_mode="${YAAMUX_ATTACH_MODE:-auto}"
    if [[ "$_aa_mode" == "auto" ]]; then
      _aa_cols=$(tput cols 2>/dev/null || echo 80)
      if (( _aa_cols < 100 )); then _aa_mode=zoom
      elif (( _aa_cols < 180 )); then _aa_mode=grid
      else _aa_mode=full
      fi
    fi
    case "$_aa_mode" in
      zoom) exec "$SELF" --mobile-attach ;;
      grid) exec "$SELF" --mobile-grid ;;
      full)
        # Prefer the current repo's session if we're inside one; otherwise the
        # only running yaamux-, or a picker.
        if tmux has-session -t "$SESSION" 2>/dev/null; then
          exec tmux attach -t "$SESSION"
        fi
        # Bash 3.2-safe: `mapfile` is Bash 4+, stock macOS still ships 3.2.
        _aa_list=(); while IFS= read -r _aa_s; do _aa_list+=("$_aa_s"); done \
          < <(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -E '^yaamux-' || true)
        case "${#_aa_list[@]}" in
          0) die "No yaamux sessions running. Start one with: yaamux" ;;
          1) exec tmux attach -t "${_aa_list[0]}" ;;
          *)
            echo "yaamux sessions:"
            for _aa_i in "${!_aa_list[@]}"; do
              printf "  %d) %s\n" "$((_aa_i+1))" "${_aa_list[$_aa_i]#yaamux-}"
            done
            read -rp "Pick [1]: " _aa_choice
            _aa_choice="${_aa_choice:-1}"
            case "$_aa_choice" in ''|*[!0-9]*) die "Invalid choice: ${_aa_choice}" ;; esac
            (( _aa_choice >= 1 && _aa_choice <= ${#_aa_list[@]} )) || die "Out of range: ${_aa_choice}"
            exec tmux attach -t "${_aa_list[$((_aa_choice-1))]}" ;;
        esac ;;
      *) die "Invalid YAAMUX_ATTACH_MODE: ${_aa_mode} (expected zoom|grid|full|auto)" ;;
    esac ;;


  --mobile-attach)
    # iOS-friendly attach: ephemeral grouped session with one pane zoomed, so a
    # 4-agent grid is readable on a phone.  Designed to be the body of a Blink /
    # Prompt 3 snippet: `mosh ... -- yaamux --mobile-attach [repo] [pane]`.
    # Session arg accepts bare repo name or full yaamux-<repo>.  With no args,
    # auto-picks the only running yaamux-* session, or prompts when several
    # exist — so the snippet works unchanged whatever repo is currently active.
    shift
    _ma_sess="${1:-}" _ma_pane="${2:-0}"
    case "$_ma_pane" in ''|*[!0-9]*) die "PANE must be a non-negative integer, got: ${_ma_pane}" ;; esac
    if [[ -z "$_ma_sess" ]]; then
      _ma_list=(); while IFS= read -r _ma_s; do _ma_list+=("$_ma_s"); done \
        < <(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -E '^yaamux-' || true)
      case "${#_ma_list[@]}" in
        0) die "No yaamux sessions running. Start one with: yaamux" ;;
        1) _ma_sess="${_ma_list[0]}" ;;
        *)
          echo "yaamux sessions:"
          for _ma_i in "${!_ma_list[@]}"; do
            printf "  %d) %s\n" "$((_ma_i+1))" "${_ma_list[$_ma_i]#yaamux-}"
          done
          read -rp "Pick [1]: " _ma_choice
          _ma_choice="${_ma_choice:-1}"
          case "$_ma_choice" in ''|*[!0-9]*) die "Invalid choice: ${_ma_choice}" ;; esac
          (( _ma_choice >= 1 && _ma_choice <= ${#_ma_list[@]} )) || die "Out of range: ${_ma_choice}"
          _ma_sess="${_ma_list[$((_ma_choice-1))]}"
          ;;
      esac
    fi
    case "$_ma_sess" in yaamux-*) ;; *) _ma_sess="yaamux-${_ma_sess}" ;; esac
    tmux has-session -t "$_ma_sess" 2>/dev/null || die "Session not found: ${_ma_sess}"
    [[ -x "$MOBILE_ATTACH" ]] || _write_mobile_attach
    exec "$MOBILE_ATTACH" "$_ma_sess" "$_ma_pane" ;;

  --mobile-grid)
    # iPad-friendly: one umbrella tmux session with one window per running
    # yaamux-<repo>, each window showing the full unzoomed agent grid.
    # Windows are linked in via `tmux link-window`, so they ARE the original
    # agents windows — changes propagate live in both directions; killing the
    # umbrella leaves the underlying yaamux sessions intact.  Designed for the
    # body of a Blink / Prompt 3 snippet on an iPad:
    #   mosh --server='…' user@host -- yaamux --mobile-grid
    # `Ctrl+Space n/p` swipes between repos, tap (mouse on) focuses an agent
    # within the grid, `Ctrl+Space Z` zooms one pane on demand.  Umbrella name
    # deliberately omits the `yaamux-` prefix so it doesn't appear in --list or
    # the --mobile-attach picker.
    #
    # CRUCIAL: do not rename the linked window.  Renaming via the umbrella
    # propagates back to the source (link-window is bidirectional on window
    # properties), and every yaamux helper targets `${SESSION}:agents` by name.
    # Instead, we set a per-window user option `@yaamux-repo` and reference it
    # from window-status-format on the umbrella.  The user option also bleeds
    # back to the source window but is custom-keyed and read by nothing else.
    shift
    _mg_list=(); while IFS= read -r _mg_s; do _mg_list+=("$_mg_s"); done \
      < <(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -E '^yaamux-' || true)
    [[ ${#_mg_list[@]} -gt 0 ]] || die "No yaamux sessions running. Start at least one with: yaamux"
    _mg_umbrella="mobile-grid"
    # Only tear down a pre-existing `mobile-grid` if it's *ours* (carries the
    # @yaamux-mobile-grid marker option).  Refuse to clobber an unrelated user
    # session that happens to share the name.
    if tmux has-session -t "$_mg_umbrella" 2>/dev/null; then
      if [[ "$(tmux show-options -v -t "$_mg_umbrella" @yaamux-mobile-grid 2>/dev/null)" == "1" ]]; then
        tmux kill-session -t "$_mg_umbrella" 2>/dev/null || true
      else
        die "A tmux session named '${_mg_umbrella}' already exists and was not created by yaamux. Rename or kill it first."
      fi
    fi
    tmux new-session -d -s "$_mg_umbrella" -n "init"
    tmux set-option -t "$_mg_umbrella" @yaamux-mobile-grid 1
    _mg_linked=0
    for _mg_sess in "${_mg_list[@]}"; do
      _mg_label="${_mg_sess#yaamux-}"
      if tmux link-window -s "${_mg_sess}:agents" -t "${_mg_umbrella}:" 2>/dev/null; then
        _mg_idx=$(tmux list-windows -t "$_mg_umbrella" -F '#{window_index}' | sort -n | tail -1)
        tmux set-option -w -t "${_mg_umbrella}:${_mg_idx}" @yaamux-repo "$_mg_label" 2>/dev/null || true
        tmux set-option -w -t "${_mg_umbrella}:${_mg_idx}" \
          window-status-format         " #I  #{@yaamux-repo} " 2>/dev/null || true
        tmux set-option -w -t "${_mg_umbrella}:${_mg_idx}" \
          window-status-current-format "#[bold,reverse] #I  #{@yaamux-repo} " 2>/dev/null || true
        _mg_linked=$((_mg_linked + 1))
      else
        warn "Could not link ${_mg_sess}:agents — skipping."
      fi
    done
    if (( _mg_linked == 0 )); then
      tmux kill-session -t "$_mg_umbrella" 2>/dev/null || true
      die "Could not link any yaamux session windows (expected window name: 'agents')."
    fi
    tmux kill-window -t "${_mg_umbrella}:init" 2>/dev/null || true
    # Match yaamux's prefix so `Ctrl+Space C` / `Ctrl+Space Q` (and arrows, zoom,
    # detach …) work consistently when the umbrella is the user's only client —
    # otherwise the umbrella would silently inherit the user's default (C-b).
    tmux set-option -t "$_mg_umbrella" prefix C-Space
    tmux set-option -t "$_mg_umbrella" mouse on
    tmux set-option -t "$_mg_umbrella" status-left  "#[fg=colour46,bold] grid "
    tmux set-option -t "$_mg_umbrella" status-right "#[fg=colour226]Ctrl+Space n/p · C connect · Q QR · D detach"
    tmux select-window -t "${_mg_umbrella}:^"
    log "yaamux grid — ${_mg_linked} repo(s) · Ctrl+Space n/p swipes · D detaches"
    exec tmux attach -t "$_mg_umbrella" ;;

  --kill)
    tmux kill-session -t "$SESSION" 2>/dev/null && log "Killed ${SESSION}." || warn "Not running."
    exit 0 ;;

  --clean)
    force=false
    [[ "${2:-}" == "--force" ]] && force=true
    tmux kill-session -t "$SESSION" 2>/dev/null || true
    skipped=0
    if [[ -d "$WORKTREES_BASE" ]]; then
      for wt in "$WORKTREES_BASE"/agent-*; do
        [[ -d "$wt" ]] || continue
        a="$(basename "$wt")"
        if ! $force && _worktree_is_dirty "$wt"; then
          warn "Skipping $a — uncommitted/untracked changes or unpushed commits."
          skipped=$((skipped+1))
          continue
        fi
        git worktree remove --force "$wt" 2>/dev/null && log "Removed $a" || true
        git branch -D "worktree/${a}" 2>/dev/null || true
      done
    fi
    # Background panel logs/meta — removed alongside worktrees so a "fresh
    # start" really is fresh. Persistence across --kill is preserved by NOT
    # touching this in --kill.
    if [[ -d "$PANELS_DIR" ]]; then
      rm -rf "$PANELS_DIR" 2>/dev/null && log "Removed bg panels dir." || true
    fi
    log "Clean complete."
    [[ $skipped -gt 0 ]] && log "Use ${BOLD}--clean --force${NC} to remove the $skipped skipped worktree(s)."
    exit 0 ;;

  --status)
    header "session: ${SESSION}"
    tmux list-windows -t "$SESSION" 2>/dev/null || echo "  Not running"
    header "panes"
    if tmux has-session -t "$SESSION" 2>/dev/null; then
      _refresh_pane_states
      SHELLS="$(tmux show-option -v -t "$SESSION" @yaamux-shells 2>/dev/null || echo 'zsh bash sh fish dash ash')"
      CNT=$(tmux display-message -p -t "${SESSION}:agents" '#{window_panes}' 2>/dev/null || echo 0)
      for ((i=0; i<CNT; i++)); do
        STATE=$(_pane_state "$i" "$SHELLS")
        TITLE=$(tmux display-message -p -t "${SESSION}:agents.${i}" '#{pane_title}' 2>/dev/null)
        if [[ "$STATE" == "panel" ]]; then
          printf "  pane #%d: %s  (control-panel)\n" "$i" "$TITLE"
        else
          printf "  pane #%d: %s  state=%s\n" "$i" "$TITLE" "$STATE"
        fi
      done
    else echo "  —"; fi
    header "worktrees"; git worktree list 2>/dev/null
    header "notifications"
    [[ -n "$NTFY_TOPIC" ]] && echo "  ntfy: ${NTFY_SERVER}/${NTFY_TOPIC} (Claude panes)" \
      || echo "  not configured — run: yaamux --setup-notify"
    exit 0 ;;

  --zoom)
    N_ARG="${2:?Usage: yaamux --zoom N}"
    IDX="$(_agent_pane_idx "$N_ARG")" || die "agent $N_ARG not found."
    tmux select-window -t "${SESSION}:agents"
    tmux select-pane -t "${SESSION}:agents.${IDX}"
    tmux resize-pane -t "${SESSION}:agents.${IDX}" -Z
    tmux attach -t "$SESSION"; exit 0 ;;

  --vscode|--code)
    N_ARG="${2:?Usage: yaamux --vscode N}"
    WPATH="${WORKTREES_BASE}/agent-${N_ARG}"
    [[ -d "$WPATH" ]] || die "agent-${N_ARG} worktree not found."
    if tmux has-session -t "$SESSION" 2>/dev/null; then
      IDX="$(_agent_pane_idx "$N_ARG" 2>/dev/null || echo '')"
      if [[ -n "$IDX" ]]; then
        warn "Stopping agent-${N_ARG} so its session can be resumed in VS Code..."
        tmux send-keys -t "${SESSION}:agents.${IDX}" C-c "" Enter; sleep 1
      fi
    fi
    command -v code &>/dev/null || \
      die "'code' not in PATH. VS Code: Cmd+Shift+P → 'Shell Command: Install code command'"
    code "$WPATH"
    log "Opened ${WPATH} in VS Code."
    echo -e "  Resume the session: Claude Code panel → Session History → Local tab"
    echo -e "  or in the integrated terminal:  claude --resume"
    exit 0 ;;

  --send)
    N_ARG="${2:?Usage: yaamux --send N \"prompt\"}"
    IDX="$(_agent_pane_idx "$N_ARG")" || die "agent $N_ARG not found."
    PROMPT="${3:?Usage: yaamux --send N \"prompt\"}"
    tmux send-keys -t "${SESSION}:agents.${IDX}" "$PROMPT" Enter
    # Read the resolved pane's @yaamux-agent for the log message — matches
    # _restart_pane and stays accurate if ordinals and agent names ever
    # diverge in a future layout mode.
    AGENT_NAME="$(tmux show-option -p -v -t "${SESSION}:agents.${IDX}" @yaamux-agent 2>/dev/null || echo "agent-${N_ARG}")"
    log "Sent to ${AGENT_NAME}."; exit 0 ;;

  --broadcast)
    PROMPT="${2:?Usage: yaamux --broadcast \"prompt\"}"
    # Iterate only agent panes (skip control-panel). N comes from the role
    # filter, not window_panes — broadcasting to the panel would clobber it.
    raw="$(tmux list-panes -t "${SESSION}:agents" \
      -F '#{pane_index}|#{@yaamux-role}' 2>/dev/null || true)"
    SENT=0
    while IFS='|' read -r pidx prole; do
      [[ -z "$pidx" || "$prole" == "control-panel" ]] && continue
      tmux send-keys -t "${SESSION}:agents.${pidx}" "$PROMPT" Enter
      SENT=$((SENT+1))
    done <<< "$raw"
    log "Broadcast to ${SENT} agents."; exit 0 ;;

  --restart)
    N_ARG="${2:?Usage: yaamux --restart N}"
    IDX="$(_agent_pane_idx "$N_ARG")" || die "agent $N_ARG not found."
    _restart_pane "$IDX"
    exit 0 ;;

  # In-tmux keybinding (`prefix r`) target. Reads $TMUX_PANE — the pane id
  # tmux exports for run-shell — and translates to a 0-based agents-pane index.
  --restart-current)
    tmux has-session -t "$SESSION" 2>/dev/null || die "No session for ${PROJECT_NAME}."
    [[ -n "${TMUX_PANE:-}" ]] || die "--restart-current must run inside tmux ($TMUX_PANE unset)."
    IDX="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_index}' 2>/dev/null)"
    [[ "$IDX" =~ ^[0-9]+$ ]] || die "Could not resolve current pane index."
    _restart_pane "$IDX"
    exit 0 ;;

  # Heal-all: restart every pane whose state is not 'running'. -y skips
  # the confirm prompt (used by the `prefix R` keybinding).
  --restart-dead)
    YES=false; [[ "${2:-}" == "-y" ]] && YES=true
    tmux has-session -t "$SESSION" 2>/dev/null || { log "No session for ${PROJECT_NAME}."; exit 0; }
    _refresh_pane_states
    SHELLS="$(tmux show-option -v -t "$SESSION" @yaamux-shells 2>/dev/null || echo 'zsh bash sh fish dash ash')"
    CNT=$(tmux display-message -p -t "${SESSION}:agents" '#{window_panes}' 2>/dev/null || echo 0)
    TARGETS=()
    for ((i=0; i<CNT; i++)); do
      STATE="$(_pane_state "$i" "$SHELLS")"
      # Skip the control-panel pane and any panes that aren't agents.
      [[ "$STATE" == "running" || "$STATE" == "panel" || "$STATE" == "missing" ]] && continue
      TARGETS+=("$i")
    done
    if [[ ${#TARGETS[@]} -eq 0 ]]; then
      log "All ${CNT} panes running — nothing to restart."
      exit 0
    fi
    if ! $YES; then
      echo -n "Restart ${#TARGETS[@]} dead/idle pane(s)? [y/N] "
      read -r ans
      [[ "$ans" =~ ^[Yy] ]] || { log "Aborted."; exit 0; }
    fi
    for IDX in "${TARGETS[@]}"; do _restart_pane "$IDX"; done
    log "Restarted ${#TARGETS[@]} pane(s)."
    exit 0 ;;

  # Internal: walk panes, classify each, write @yaamux-state. Invoked by the
  # status-interval refresher and the pane-exited hook.
  --refresh-states)
    _refresh_pane_states
    exit 0 ;;

  --logs)
    WIN="logs"
    if ! tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$WIN"; then
      die "No logs window — start yaamux first."
    fi
    tmux select-window -t "${SESSION}:${WIN}"; tmux attach -t "$SESSION"; exit 0 ;;

  --sync)
    CUR=$(tmux show-window-options -t "${SESSION}:agents" synchronize-panes 2>/dev/null | awk '{print $2}')
    if [[ "$CUR" == "on" ]]; then
      tmux set-window-option -t "${SESSION}:agents" synchronize-panes off; log "Sync OFF"
    else
      tmux set-window-option -t "${SESSION}:agents" synchronize-panes on
      warn "Sync ON — keystrokes go to ALL panes. Run --sync again to disable."
    fi; exit 0 ;;

  --setup-notify)
    echo -e "\n${BOLD}yaamux notification setup${NC}"
    echo "Push fires for CLAUDE panes only (hook-driven). Others: tmux activity highlight."
    echo ""
    read -rp "ntfy topic (random string = password): " TOPIC
    read -rp "ntfy server [https://ntfy.sh]: " SERVER; SERVER="${SERVER:-https://ntfy.sh}"
    read -rp "Blink snippet key [yaamux-attach]: " BK; BK="${BK:-yaamux-attach}"
    read -rp "Slack webhook URL (optional): " SLACK
    mkdir -p "$(dirname "$NOTIFY_CONF")"
    cat > "$NOTIFY_CONF" << CONF
NTFY_TOPIC="${TOPIC}"
NTFY_SERVER="${SERVER}"
BLINK_SNIPPET_KEY="${BK}"
SSH_HOST="${HOST_DISPLAY}"
SSH_USER="$(whoami)"
SLACK_WEBHOOK_URL="${SLACK}"
CONF
    chmod 600 "$NOTIFY_CONF"
    _write_notify_hook
    _write_mobile_attach
    _write_settings_json
    echo ""
    log "Done. In the ntfy app, subscribe to topic '${TOPIC}' on ${SERVER}"
    log "Blink snippet '${BK}' (one snippet, auto picks UI from terminal width):"
    log "  mosh --server='${MOSH_SERVER_CMD}' $(whoami)@${HOST_DISPLAY} -- yaamux --auto-attach"
    log "ssh fallback (no mosh on remote):"
    log "  ssh -t $(whoami)@${HOST_DISPLAY} 'yaamux --auto-attach'"
    exit 0 ;;

  --help|-h)
    sed -n '2,41p' "$SELF" | sed 's/^# \{0,1\}//'
    exit 0 ;;

  "") : ;;
  *) die "Unknown flag: $1   (try: yaamux --help)" ;;
esac

# =============================================================================
#  START — resolve N + agent types
# =============================================================================
# Per-project defaults (.yaamux/config) — overridden by CLI args
# shellcheck disable=SC1091
[[ -f "${REPO_ROOT}/.yaamux/config" ]] && source "${REPO_ROOT}/.yaamux/config" 2>/dev/null || true

# Control-panel visibility/mode — built-in defaults, then global, then per-repo
# (last wins). Empty global file = no override; per-repo .yaamux/state overrides
# both. Both files are simple KEY=value, sourceable.
CONTROL_PANEL_VISIBLE="${CONTROL_PANEL_VISIBLE:-true}"
CONTROL_PANEL_MODE="${CONTROL_PANEL_MODE:-auto}"
# shellcheck disable=SC1090,SC1091
[[ -f "$PANEL_CONF_GLOBAL" ]] && source "$PANEL_CONF_GLOBAL" 2>/dev/null || true
# shellcheck disable=SC1090,SC1091
[[ -f "$PANEL_CONF_LOCAL"  ]] && source "$PANEL_CONF_LOCAL"  2>/dev/null || true

if [[ -z "$N" && ${#PATTERN[@]} -eq 0 ]]; then
  N="${YAAMUX_DEFAULT_COUNT:-$DEFAULT_COUNT}"
elif [[ -z "$N" ]]; then
  N=${#PATTERN[@]}
fi
[[ "$N" -lt 1 ]] && die "Need at least 1 agent."
[[ "$N" -gt $MAX_AGENTS ]] && die "Max ${MAX_AGENTS} agents (asked for ${N})."
if [[ ${#PATTERN[@]} -eq 0 ]]; then
  if [[ -n "${YAAMUX_DEFAULT_PATTERN:-}" ]]; then
    # shellcheck disable=SC2206
    PATTERN=(${YAAMUX_DEFAULT_PATTERN})
  else
    PATTERN=("$DEFAULT_AGENT")
  fi
fi
for ((i=0; i<N; i++)); do
  AGENT_TYPES+=("${PATTERN[$((i % ${#PATTERN[@]}))]}")
done

# Build agent-name list
AGENTS=()
for ((i=1; i<=N; i++)); do AGENTS+=("agent-${i}"); done

# ── Pre-flight ─────────────────────────────────────────────────────────────────
command -v tmux &>/dev/null || die "tmux not found — brew install tmux"
command -v git  &>/dev/null || die "git not found"

log "Project:   ${PROJECT_NAME}   (session: ${SESSION})"
log "Agents:    ${N}"
log "Host:      ${HOST_DISPLAY}"

header "agent line-up"
MISSING=()
HAS_CLAUDE=false
for i in "${!AGENT_TYPES[@]}"; do
  t="${AGENT_TYPES[$i]}"; bin="$(agent_bin "$t")"
  [[ "$t" == "claude" ]] && HAS_CLAUDE=true
  [[ -z "$bin" ]] && die "Invalid agent type '${t}'. Use: claude|gemini|copilot|codex"
  if command -v "$bin" &>/dev/null; then
    echo -e "  $(agent_icon "$t") ${AGENTS[$i]} → ${BOLD}${t}${NC}"
  else
    echo -e "  $(agent_icon "$t") ${AGENTS[$i]} → ${RED}${t} — '${bin}' not installed${NC}"
    MISSING+=("$t")
  fi
done
if [[ ${#MISSING[@]} -gt 0 ]]; then
  echo ""
  warn "Install missing CLIs:"
  for m in $(printf '%s\n' "${MISSING[@]}" | sort -u); do
    case "$m" in
      claude)  echo "    npm install -g @anthropic-ai/claude-code" ;;
      gemini)  echo "    npm install -g @google/gemini-cli" ;;
      copilot) echo "    npm install -g @github/copilot" ;;
      codex)   echo "    npm install -g @openai/codex" ;;
    esac
  done
  die "Install the above, or pick different agent types."
fi

MOSH_OK=false
command -v mosh &>/dev/null && MOSH_OK=true || warn "mosh not found — brew install mosh"
# New-stack soft deps: warn but don't die. lazygit drives the `git` window;
# gh backs the PR/CI flags; delta/bat polish diffs and file viewing in panes.
command -v lazygit &>/dev/null || warn "lazygit not found — \`git\` window will be skipped. (brew install lazygit)"
command -v gh      &>/dev/null || warn "gh not found — --pr/--watch-pr/--auto-merge/--ci-status will fail. (brew install gh && gh auth login)"
command -v delta   &>/dev/null || warn "git-delta not found — diffs will render plain. (brew install git-delta)"
command -v bat     &>/dev/null || warn "bat not found — files will page through less. (brew install bat)"
# If mosh is installed but mosh-server isn't on ssh's non-interactive PATH,
# iOS clients opening the QR'd `mosh://user@host` URL will hit NoMoshServerArgs.
# This is the v0.1.8 trade-off: the URL scheme can't carry the --server= PATH
# prelude. Surface the fix once at startup so users find it before scanning.
if $MOSH_OK && ! _mosh_server_on_default_path; then
  warn "mosh-server is off ssh's non-interactive PATH — iOS mosh:// QR will fail with NoMoshServerArgs."
  warn "Fix once: ${BOLD}yaamux --prepare-host${NC}  (symlinks mosh-server into /usr/local/bin, needs sudo)"
fi
[[ -n "${ANTHROPIC_API_KEY:-}" ]] && $HAS_CLAUDE && \
  warn "ANTHROPIC_API_KEY set — Claude Remote Control needs claude.ai OAuth"
[[ -n "${NTFY_TOPIC:-}" ]] && $HOST_IS_LOCAL && \
  warn "Local-only hostname '${HOST_DISPLAY}' — push notifications won't be reachable remotely. Install tailscale or set SSH_HOST in $NOTIFY_CONF."
[[ "$YAAMUX_YOLO" == "1" ]] && \
  warn "YOLO mode — agents will run with full permission bypass. ${BOLD}Run on code you trust.${NC}"

# ── Hooks + settings ───────────────────────────────────────────────────────────
mkdir -p "$HOOKS_DIR" "$LOG_DIR"
_write_guard_hook
[[ -f "${REPO_ROOT}/.claude/settings.json" ]] || _write_settings_json
# self-heal notify scripts if configured but missing
if [[ -f "$NOTIFY_CONF" ]]; then
  [[ -f "${HOOKS_DIR}/yaamux-notify.sh" ]] || { _write_notify_hook; _write_settings_json; }
  [[ -f "$MOBILE_ATTACH" ]]              || _write_mobile_attach
fi

# ── Files to copy/link into each worktree (default .env*; extend via .worktreeinclude)
INCLUDE_FILES=()
while IFS= read -r -d '' f; do INCLUDE_FILES+=("$f"); done < <(_collect_include_files)

# ── Worktrees ──────────────────────────────────────────────────────────────────
IS_GIT=true; git rev-parse --is-inside-work-tree &>/dev/null || IS_GIT=false
mkdir -p "$WORKTREES_BASE"
for agent in "${AGENTS[@]}"; do
  WPATH="${WORKTREES_BASE}/${agent}"; BRANCH="worktree/${agent}"
  if [[ "$IS_GIT" == "true" ]] && ! _worktree_exists "$WPATH"; then
    git show-ref --quiet "refs/heads/${BRANCH}" || git branch "$BRANCH" HEAD
    git worktree add "$WPATH" "$BRANCH"; log "Created worktree: ${agent}"
  else
    mkdir -p "$WPATH"
  fi
  for envfile in "${INCLUDE_FILES[@]+"${INCLUDE_FILES[@]}"}"; do
    dest="${WPATH}/$(basename "$envfile")"
    [[ -e "$dest" || -L "$dest" ]] && continue   # don't clobber agent edits
    if [[ "$YAAMUX_LINK_ENV" == "1" ]]; then
      ln -sf "$envfile" "$dest"
    else
      cp "$envfile" "$dest"
    fi
  done
done

grep -q "# BEGIN yaamux" "${HOME}/.ssh/config" 2>/dev/null || _gen_ssh_config

# ── tmux session ───────────────────────────────────────────────────────────────
if tmux has-session -t "$SESSION" 2>/dev/null; then
  warn "Session ${SESSION} already running — attaching."
  _refresh_pane_states
  # If state says panel should be visible but no pane carries the role
  # (manually killed, or older yaamux build), recreate it before attach.
  _cpanel_self_heal
  HEAL_IDX=()
  _triage_prompt "$SESSION" HEAL_IDX
  case $? in
    1) log "Quit before attach."; exit 0 ;;
    2) for i in "${HEAL_IDX[@]}"; do _restart_pane "$i"; done; log "Healed ${#HEAL_IDX[@]} pane(s)." ;;
  esac
  tmux attach -t "$SESSION"; exit 0
fi

tmux new-session -d -s "$SESSION" -n "agents" -c "${WORKTREES_BASE}/agent-1"

# Normalize pane-base-index to 0 on yaamux's own windows so the `.0`/`.1`-style
# pane targets used throughout the script hold regardless of the user's
# ~/.tmux.conf (a user with `setw -g pane-base-index 1` would otherwise see
# panel pane assignment land on the wrong pane).  Per-window scope means
# the user's other tmux sessions are unaffected.
tmux set-window-option -t "${SESSION}:agents" pane-base-index 0 2>/dev/null || true

# Metadata (yaamux user-options — consumed by --list, --restart, etc.)
tmux set-option -t "$SESSION" @yaamux-repo "$REPO_ROOT"
# Shell set used by _pane_state to classify "agent exited, only shell left".
# Computed once at session start from $SHELL + the common defaults.
tmux set-option -t "$SESSION" @yaamux-shells \
  "zsh bash sh fish dash ash $(basename "${SHELL:-zsh}" 2>/dev/null || echo zsh)"

# Wire delta + bat into the session env if installed. New processes spawned
# in any pane inherit these; the user's global gitconfig is untouched.
# (lazygit ignores GIT_PAGER — its delta wiring is via the repo-local config
# written below when the `git` window is created.)
command -v delta &>/dev/null && \
  tmux set-environment -t "$SESSION" GIT_PAGER "delta --paging=never"
command -v bat &>/dev/null && \
  tmux set-environment -t "$SESSION" PAGER "bat --paging=auto"

# Options
tmux set-option -g -t "$SESSION" history-limit $SCROLLBACK
tmux set-option    -t "$SESSION" prefix C-Space
tmux unbind-key    -T prefix C-b
tmux bind-key      -T prefix C-Space send-prefix
tmux bind-key      -T copy-mode-vi y     send-keys -X copy-pipe-and-cancel "pbcopy"
tmux bind-key      -T copy-mode    y     send-keys -X copy-pipe-and-cancel "pbcopy"
tmux bind-key      -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "pbcopy"
tmux bind-key      -T prefix S set-window-option synchronize-panes \; \
  display-message "sync: #{?synchronize-panes,ON,OFF}"
# Pane-health affordances: r restart current, R restart all dead/idle, L clear.
tmux bind-key      -T prefix r run-shell -b "${SELF} --restart-current"
tmux bind-key      -T prefix R confirm-before -p "restart all dead/idle agents? (y/n) " \
  "run-shell -b '${SELF} --restart-dead -y'"
tmux bind-key      -T prefix L send-keys C-l \; clear-history
# display-popup requires tmux 3.2+; suppress bind failure on older tmux so
# session startup still succeeds (the popups just won't be available there;
# `yaamux --keys` / `yaamux --connect` still work from any shell).
tmux bind-key      -T prefix '?' display-popup -E -w 88 -h 40 \
  "'${SELF}' --keys | less -R" 2>/dev/null || true
tmux bind-key      -T prefix '/' list-keys
# Connect info: prefix C → text popup, prefix Q → QR-code popup (if qrencode installed).
# `read` keeps the popup open until the user dismisses with Enter.
tmux bind-key      -T prefix C display-popup -E -w '90%' -h '70%' \
  "'${SELF}' --connect; printf '\\n  (press Enter to close)'; read -r _" 2>/dev/null || true
tmux bind-key      -T prefix Q display-popup -E -w '70%' -h '90%' \
  "'${SELF}' --connect --qr; printf '\\n  (press Enter to close)'; read -r _" 2>/dev/null || true
# Jump to the lazygit `git` window. Silent no-op if lazygit isn't installed
# (the window doesn't exist).
# Only bind G if lazygit is available — otherwise the `git` window won't have
# been created, and pressing G would show "can't find window: git" in tmux.
if command -v lazygit &>/dev/null; then
  tmux bind-key    -T prefix G select-window -t "${SESSION}:git" 2>/dev/null || true
fi
# Control Panel: prefix p toggles show/hide; remembers via .yaamux/state.
tmux bind-key      -T prefix p run-shell -b "${SELF} --toggle-panel"
# Ergonomic zoom toggle — Ctrl+Space → Space is a one-handed double-tap.
# tmux's idiomatic `prefix Z` keeps working alongside this.
tmux bind-key      -T prefix Space resize-pane -Z
# prefix 1..9 → jump straight to the Nth agent pane (skips control-panel).
# Resolved via --goto N → _agent_pane_idx → select-pane.
tmux bind-key      -T prefix 1 run-shell -b "${SELF} --goto 1"
tmux bind-key      -T prefix 2 run-shell -b "${SELF} --goto 2"
tmux bind-key      -T prefix 3 run-shell -b "${SELF} --goto 3"
tmux bind-key      -T prefix 4 run-shell -b "${SELF} --goto 4"
tmux bind-key      -T prefix 5 run-shell -b "${SELF} --goto 5"
tmux bind-key      -T prefix 6 run-shell -b "${SELF} --goto 6"
tmux bind-key      -T prefix 7 run-shell -b "${SELF} --goto 7"
tmux bind-key      -T prefix 8 run-shell -b "${SELF} --goto 8"
tmux bind-key      -T prefix 9 run-shell -b "${SELF} --goto 9"
tmux set-option    -t "$SESSION" mouse on
tmux set-option    -t "$SESSION" monitor-activity on
tmux set-option    -t "$SESSION" visual-activity off
tmux set-option    -t "$SESSION" pane-border-status top
# Health glyph (✓ ⚠ ✗) reads @yaamux-state which the refresher updates.
tmux set-option    -t "$SESSION" pane-border-format \
  " #[bold]#{pane_title}#[nobold] #{?#{==:#{@yaamux-state},dead},#[fg=colour196]✗,#{?#{==:#{@yaamux-state},idle},#[fg=colour220]⚠,#[fg=colour46]✓}} #{?pane_active,#[fg=colour46]●,#[fg=colour238]○} "
tmux set-option    -t "$SESSION" status on
tmux set-option    -t "$SESSION" status-interval 5
tmux set-option    -t "$SESSION" status-style "bg=colour235 fg=white"
tmux set-option    -t "$SESSION" status-left \
  "#{?client_prefix,#[fg=colour226 bold]⌨ ,}#[fg=colour46 bold] ◉ ${SESSION} #[fg=white]│ #[fg=colour39] #(git -C '${REPO_ROOT}' rev-parse --abbrev-ref HEAD 2>/dev/null || echo '—') #[fg=white]│ #[fg=colour226]#{?synchronize-panes,⚡SYNC ,}#[fg=white]"
tmux set-option    -t "$SESSION" status-left-length 120
# Status-right embeds a per-tick refresh via #(): cheap shell-out to update
# @yaamux-state on every status interval. The text after the refresh is the
# per-pane attention chips (--status-render), agent count, clock, and a hint.
tmux set-option    -t "$SESSION" status-right \
  "#(${SELF} --refresh-states >/dev/null 2>&1; ${SELF} --status-render)#[fg=colour81]${N} agents #[fg=white]│ #[fg=colour226]%H:%M #[fg=white]│ C-Space+? help"
# Wider status-right so the per-pane chips don't clip on bigger panes counts.
tmux set-option    -t "$SESSION" status-right-length 200
tmux set-option    -t "$SESSION" window-status-current-style  "bg=colour27 fg=white bold"
tmux set-option    -t "$SESSION" window-status-activity-style "bg=colour130 fg=white bold"
tmux set-option    -t "$SESSION" pane-active-border-style "fg=colour46"
tmux set-option    -t "$SESSION" pane-border-style "fg=colour238"
# Event-driven refresh too — when a pane process exits, update immediately
# rather than waiting for the next status tick. Also try to self-heal the
# control-panel pane if it was the one that exited.
tmux set-hook      -t "$SESSION" pane-exited \
  "run-shell -b '${SELF} --refresh-states >/dev/null 2>&1; ${SELF} --cpanel-self-heal >/dev/null 2>&1'"
# Clear the per-pane notification badge when the user focuses a pane — the
# bottom indicator is "attention pending", focus is acknowledgement.
tmux set-hook      -t "$SESSION" pane-focus-in \
  "run-shell -b \"tmux set-option -p -t '#{pane_id}' @yaamux-notif-pending 0 2>/dev/null || true\""

# Decide the effective panel-layout mode. Auto = parity-based: even-N gets a
# right-column sidebar so the agent grid stays balanced; odd-N gets one more
# tile. Small terminals (cols < YAAMUX_CPANEL_MIN_COLS) fall back to tile.
EFFECTIVE_PANEL_MODE="off"
if [[ "$CONTROL_PANEL_VISIBLE" == "true" ]]; then
  EFFECTIVE_PANEL_MODE="$CONTROL_PANEL_MODE"
  if [[ "$EFFECTIVE_PANEL_MODE" == "auto" ]]; then
    if (( N % 2 == 0 )); then EFFECTIVE_PANEL_MODE="sidebar"; else EFFECTIVE_PANEL_MODE="tile"; fi
  fi
  MIN_COLS="${YAAMUX_CPANEL_MIN_COLS:-120}"
  COLS_NOW="$(tput cols 2>/dev/null || echo 200)"
  if (( COLS_NOW < MIN_COLS )) && [[ "$EFFECTIVE_PANEL_MODE" == "sidebar" ]]; then
    warn "Narrow terminal (${COLS_NOW} cols) — switching control panel to tile mode."
    EFFECTIVE_PANEL_MODE="tile"
  fi
fi

# Build N agent panes + (optionally) the control-panel pane.
# AGENT_PANE_IDX maps the 1-based agent number (i+1) → tmux pane index. In
# tile/no-panel mode this is just 0..N-1; in sidebar mode the panel takes
# index 1, so agents land at 0, 2, 3, ..., N.
LAYOUT="$(_layout_for "$N" "$YAAMUX_LAYOUT")"
AGENT_PANE_IDX=()

if [[ "$EFFECTIVE_PANEL_MODE" == "sidebar" ]]; then
  # Split the right 30% off before adding more agents — preserves the column.
  tmux split-window -h -p 30 -t "${SESSION}:agents" -c "$REPO_ROOT"
  tmux set-option -p -t "${SESSION}:agents.1" @yaamux-role control-panel
  tmux set-option -p -t "${SESSION}:agents.1" @yaamux-type panel
  tmux set-option -p -t "${SESSION}:agents.1" @yaamux-state panel
  tmux select-pane -t "${SESSION}:agents.1" -T "🎛  control-panel"
  AGENT_PANE_IDX[0]=0
  # Subsequent splits target pane 0 (the left agent area) so the sidebar
  # column at index 1 stays intact. Each new split appends index 2, 3, ...
  for ((i=1; i<N; i++)); do
    tmux split-window -t "${SESSION}:agents.0" -c "${WORKTREES_BASE}/agent-$((i+1))"
    AGENT_PANE_IDX[i]=$((i+1))
  done
  # No select-layout — the manual sidebar split must survive. tmux preserves
  # this when no named layout is applied.
else
  # Tile mode (also no-panel mode): existing behavior unchanged.
  AGENT_PANE_IDX[0]=0
  for ((i=1; i<N; i++)); do
    tmux split-window -t "${SESSION}:agents" -c "${WORKTREES_BASE}/agent-$((i+1))"
    tmux select-layout -t "${SESSION}:agents" "$LAYOUT"
    AGENT_PANE_IDX[i]=$i
  done
  tmux select-layout -t "${SESSION}:agents" "$LAYOUT"

  if [[ "$EFFECTIVE_PANEL_MODE" == "tile" ]]; then
    # Add the panel as one more tile. Re-tile to re-balance.
    tmux split-window -t "${SESSION}:agents" -c "$REPO_ROOT"
    PANEL_IDX="$(tmux display-message -p -t "${SESSION}:agents" '#{window_panes}')"
    PANEL_IDX=$((PANEL_IDX - 1))
    tmux set-option -p -t "${SESSION}:agents.${PANEL_IDX}" @yaamux-role control-panel
    tmux set-option -p -t "${SESSION}:agents.${PANEL_IDX}" @yaamux-type panel
    tmux set-option -p -t "${SESSION}:agents.${PANEL_IDX}" @yaamux-state panel
    tmux select-pane -t "${SESSION}:agents.${PANEL_IDX}" -T "🎛  control-panel"
    tmux select-layout -t "${SESSION}:agents" tiled
  fi
fi

# remote-srv window (only if a Claude pane exists)
if $HAS_CLAUDE; then
  tmux new-window -t "$SESSION" -n "remote-srv" -c "$REPO_ROOT"
  tmux set-window-option -t "${SESSION}:remote-srv" pane-base-index 0 2>/dev/null || true
fi

# logs window — N panes tiled
tmux new-window -t "$SESSION" -n "logs" -c "$LOG_DIR"
tmux set-window-option -t "${SESSION}:logs" pane-base-index 0 2>/dev/null || true
for ((i=1; i<N; i++)); do
  tmux split-window -t "${SESSION}:logs" -c "$LOG_DIR"
  tmux select-layout -t "${SESSION}:logs" tiled
done
tmux select-layout -t "${SESSION}:logs" tiled

# `git` window — one lazygit pane in REPO_ROOT (worktrees + branches + PRs).
# Distinct from the Control Panel *pane* (which lives in the `agents` window
# and shows yaamux/tmux state): this is a dedicated window for git ops,
# jumped to via `Ctrl+Space + G`. Lazygit ignores $GIT_PAGER and reads its
# own config, so we drop a repo-local config under .yaamux/ (matches the
# convention .yaamux/state, .yaamux/panels/, etc.) and point LG_CONFIG_FILE
# at it — no global ~/.config/lazygit changes.
if command -v lazygit &>/dev/null; then
  _LG_CONFIG_DIR="${REPO_ROOT}/.yaamux/lazygit"
  mkdir -p "$_LG_CONFIG_DIR"
  if command -v delta &>/dev/null; then
    cat > "${_LG_CONFIG_DIR}/config.yml" <<'LG_EOF'
git:
  paging:
    colorArg: always
    pager: delta --dark --paging=never
LG_EOF
  else
    : > "${_LG_CONFIG_DIR}/config.yml"
  fi
  tmux new-window  -t "$SESSION" -n "git" -c "$REPO_ROOT"
  tmux set-window-option -t "${SESSION}:git" pane-base-index 0 2>/dev/null || true
  tmux select-pane -t "${SESSION}:git.0" -T "🧭 lazygit · ${PROJECT_NAME}"
  tmux send-keys   -t "${SESSION}:git" \
    "LG_CONFIG_FILE='${_LG_CONFIG_DIR}/config.yml' lazygit" Enter
fi

# Keep dead agent panes visible (showing tmux's exit banner) instead of
# collapsing the tiled grid, so the user sees what died and --restart-dead
# has something to find.
tmux set-window-option -t "${SESSION}:agents" remain-on-exit on

# Resolve the version string once. We mirror _show_version's lookup (VERSION
# file lives next to the script for git installs, under share/yaamux/ for brew).
YAAMUX_VERSION_STR="dev"
for _ver_candidate in "${YAAMUX_HOME}/VERSION" "${YAAMUX_HOME}/../share/yaamux/VERSION"; do
  if [[ -f "$_ver_candidate" ]]; then
    YAAMUX_VERSION_STR="$(cat "$_ver_candidate")"
    break
  fi
done

# Session-level env: inherited by any *new* shell spawned later in this session
# (e.g. a manually-opened pane). The current agent shells are already alive so
# we still need the per-pane export below — this just plugs the new-shell hole.
tmux set-environment -t "$SESSION" YAAMUX_SESSION   "$SESSION"
tmux set-environment -t "$SESSION" YAAMUX_REPO_ROOT "$REPO_ROOT"
tmux set-environment -t "$SESSION" YAAMUX_VERSION   "$YAAMUX_VERSION_STR"
tmux set-environment -t "$SESSION" YAAMUX_AGENT_MODE safe
tmux set-environment -t "$SESSION" YAAMUX_AGENT_TOTAL "${#AGENTS[@]}"

# ── Launch agents ──────────────────────────────────────────────────────────────
for i in "${!AGENTS[@]}"; do
  agent="${AGENTS[$i]}"; type="${AGENT_TYPES[$i]}"
  LOG_FILE="${LOG_DIR}/${agent}.log"
  # AGENT_PANE_IDX maps the agent ordinal to its tmux pane index — same in
  # tile mode (i==idx), shifted in sidebar mode where the panel takes idx 1.
  apidx="${AGENT_PANE_IDX[$i]:-$i}"
  tmux select-pane -t "${SESSION}:agents.${apidx}" -T "$(agent_icon "$type") ${agent} · ${type}"
  tmux set-option  -p -t "${SESSION}:agents.${apidx}" @yaamux-role  "agent"
  tmux set-option  -p -t "${SESSION}:agents.${apidx}" @yaamux-agent "$agent"
  tmux set-option  -p -t "${SESSION}:agents.${apidx}" @yaamux-type  "$type"
  tmux set-option  -p -t "${SESSION}:agents.${apidx}" @yaamux-state "running"
  tmux pipe-pane   -t "${SESSION}:agents.${apidx}" -o "cat >> ${LOG_FILE}"
  # Resolve the actual pane id so the agent's shell can quote itself in logs /
  # send-keys to siblings. display-message reads the target pane's #{pane_id}.
  apid="$(tmux display-message -p -t "${SESSION}:agents.${apidx}" '#{pane_id}' 2>/dev/null || echo '')"
  # Export YAAMUX_* into the pane's shell, then launch the agent. The exports
  # land in the live shell (so a Ctrl-C + manual relaunch still sees them) and,
  # together with the session-level set-environment above, cover both the
  # "current shell" and "new shell in this session" cases.
  agent_invocation="$(agent_cmd "$type" "$agent")"
  tmux send-keys -t "${SESSION}:agents.${apidx}" \
    "export YAAMUX_AGENT_NAME='${agent}' YAAMUX_AGENT_NUMBER=$((i+1)) YAAMUX_AGENT_TOTAL=${#AGENTS[@]} YAAMUX_AGENT_TYPE='${type}' YAAMUX_SESSION='${SESSION}' YAAMUX_PANE_ID='${apid}' YAAMUX_REPO_ROOT='${REPO_ROOT}' YAAMUX_VERSION='${YAAMUX_VERSION_STR}' YAAMUX_AGENT_MODE=safe; clear; ${agent_invocation}" Enter
  tmux select-pane -t "${SESSION}:logs.${i}" -T "📋 ${agent}"
  tmux send-keys   -t "${SESSION}:logs.${i}" \
    "tail -f ${LOG_FILE} 2>/dev/null || { sleep 2; exec tail -f ${LOG_FILE}; }" Enter
done

# Launch the Control Panel TUI in the panel pane (if visible).
if [[ "$EFFECTIVE_PANEL_MODE" == "sidebar" || "$EFFECTIVE_PANEL_MODE" == "tile" ]]; then
  _write_cpanel
  PANEL_IDX="$(_panel_pane_idx)"
  if [[ -n "$PANEL_IDX" ]]; then
    tmux send-keys -t "${SESSION}:agents.${PANEL_IDX}" \
      "clear; YAAMUX_SELF='${SELF}' YAAMUX_SESSION='${SESSION}' YAAMUX_NOTIF_LOG='${NOTIF_LOG}' '${CPANEL_SCRIPT}'" Enter
  fi
fi

# remote-control server (Claude)
if $HAS_CLAUDE; then
  tmux select-pane -t "${SESSION}:remote-srv.0" -T "🌐 remote-srv"
  tmux send-keys   -t "${SESSION}:remote-srv" \
    "claude remote-control --spawn worktree --capacity ${N} --name '${PROJECT_NAME}'" Enter
fi

tmux select-window -t "${SESSION}:agents"
tmux select-pane   -t "${SESSION}:agents.0"

# ── Summary ────────────────────────────────────────────────────────────────────
echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}${BOLD} yaamux · ${PROJECT_NAME} · ${N} agents${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
for i in "${!AGENTS[@]}"; do
  echo -e "   $(agent_icon "${AGENT_TYPES[$i]}") ${AGENTS[$i]} → ${AGENT_TYPES[$i]}"
done
echo ""
echo -e " ${CYAN}Remote — one snippet, auto picks UI from terminal width:${NC}"
if $MOSH_OK; then
  echo -e "   mosh --server='${MOSH_SERVER_CMD}' $(whoami)@${HOST_DISPLAY} -- yaamux --auto-attach"
  echo -e "   ${CYAN}auto thresholds:${NC} <100c → zoom (iPhone) · <180c → grid (iPad) · ≥180c → full (desktop)"
  echo -e "   ${CYAN}force a mode:${NC} mosh ... -- env YAAMUX_ATTACH_MODE=zoom|grid|full yaamux --auto-attach"
  echo -e "   ${CYAN}explicit flags:${NC} yaamux --mobile-attach · --mobile-grid · or 'tmux attach -t ${SESSION}'"
else
  echo -e "   ssh -t $(whoami)@${HOST_DISPLAY} 'yaamux --auto-attach'"
  echo -e "   ${CYAN}force a mode:${NC} ssh -t ... 'YAAMUX_ATTACH_MODE=zoom yaamux --auto-attach'"
fi
$HAS_CLAUDE && echo -e "   claude.ai/code — Claude panes (browser / iOS app)"
echo ""
echo -e " ${CYAN}Manage:${NC}  yaamux --send N \"x\" · --broadcast \"x\" · --restart N · --vscode N · --logs · --connect [--qr]"
echo -e " ${CYAN}Prefix:${NC}  Ctrl+Space → arrows · Z zoom · [ scroll · y copy · S sync · D detach · ${BOLD}C connect${NC} · ${BOLD}Q QR${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

tmux attach -t "$SESSION"
