# ── Agent brief ───────────────────────────────────────────────────────────────
# `yaamux --agent-brief [--format markdown|text|json]` — emit an
# agent-optimized CLI brief. The data lives in a single source-of-truth
# table (_brief_data) so all three formats stay in lockstep, and the bats
# drift-guard test verifies every flag in the case block is catalogued
# (either as a user-facing brief row or under the operator-only `internal`
# / `setup` groups). Issue #29 Tier 2.

_brief_data() {
  # Tab-separated:   GROUP \t FLAG \t SUMMARY
  # Groups rendered in the brief (agent-facing): read, coordinate, background, ship, refused
  # Groups intentionally hidden from the brief: setup (operator-time), internal (UI / connect)
  # If you add a new flag to the main case block, add it here too — bats catches drift.
  cat <<'BRIEF_DATA'
read	--list	list yaamux sessions on this machine (`--list --json` is a stable schema)
read	--status	per-pane health snapshot of this session
read	--keys	full CLI cheat sheet
read	--version	yaamux version
read	--refresh-states	recompute pane state badges
read	--ci-status	CI status for an agent's PR: `--ci-status [N]` (no N = every pane that has a PR)
read	--diff	diff agent N's branch vs `origin/main`: `--diff N` (delta-highlighted if installed)
coordinate	--send	send a prompt to sibling agent N: `--send N "<prompt>"`
coordinate	--exec	synchronous run-and-wait: `--exec N "<cmd>" [timeout]`
coordinate	--broadcast	send to every agent: `--broadcast "<prompt>"`
coordinate	--restart	relaunch agent N: `--restart N`
coordinate	--restart-current	relaunch the agent in the current pane
coordinate	--restart-dead	relaunch every dead / idle agent
coordinate	--zoom	attach with pane N zoomed: `--zoom N`
background	--bg	start a long-running pane: `--bg <name> "<cmd>"`
background	--bg-tail	read panel output: `--bg-tail <name> [--from N] [--follow]`
background	--bg-list	list panels with status / RC: `--bg-list [--json]`
background	--bg-kill	stop a running panel: `--bg-kill <name>`
ship	--pr	push + open a PR for agent N: `--pr N "title" [--merge]`
ship	--watch-pr	block until CI passes / fails for agent N's PR: `--watch-pr N`
ship	--auto-merge	enable auto-merge on agent N's existing PR: `--auto-merge N`
ship	--logs	tail combined agent logs: `--logs [N]`
ship	--vscode	open agent N's worktree in VS Code: `--vscode N` (alias: `--code`)
refused	--kill	tears down the session (refused while YAAMUX_AGENT_MODE=safe)
refused	--clean	removes worktrees, incl. yours (refused while YAAMUX_AGENT_MODE=safe)
refused	--install	host-level CLI install (refused while YAAMUX_AGENT_MODE=safe)
refused	--uninstall	host-level CLI uninstall (refused while YAAMUX_AGENT_MODE=safe)
refused	--install-service	macOS LaunchAgent install (refused while YAAMUX_AGENT_MODE=safe)
setup	--init	scaffold AGENTS.md / .yaamux/config / skill (operator runs once per repo)
setup	--update	pull a newer yaamux into ~/.yaamux
setup	--add-docs	copy YAAMUX.md into the repo
setup	--prepare-host	one-time mosh-server PATH fix on a Mac host
setup	--ssh-config	emit an ssh config block for `--remote`
setup	--setup-notify	configure push notifications
setup	--agent-brief	this command itself (`--format text|markdown|json`)
internal	--cpanel	control-panel TUI process (run inside the pane)
internal	--panel-show	show the Control Panel pane
internal	--panel-hide	hide the Control Panel pane
internal	--toggle-panel	toggle the Control Panel pane
internal	--cpanel-self-heal	repair a stuck Control Panel pane
internal	--status-render	tmux status-right renderer
internal	--goto	tmux-binding: jump to pane N
